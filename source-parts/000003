        assert!(relay_local_from(Some("1")));
        assert!(relay_local_from(Some(" true ")));
        assert!(!relay_local_from(Some("0")));
        assert!(!relay_local_from(Some("")));
        assert!(!relay_local_from(None));
    }

    #[test]
