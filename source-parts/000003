def _local_datetime(timestamp: float) -> dt.datetime:
    tz_name = (os.getenv("PRAXIS_TZ") or "Europe/Moscow").strip()
    try:
        from zoneinfo import ZoneInfo
        return dt.datetime.fromtimestamp(timestamp, ZoneInfo(tz_name))
    except Exception:
