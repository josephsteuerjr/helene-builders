async function api<T>(path:string,body?:unknown,signal?:AbortSignal):Promise<T> {
  const config=window.PULT_CONFIG_OVERRIDE||window.PULT_CONFIG||window.DESK_CONFIG_OVERRIDE||window.DESK_CONFIG||{};
