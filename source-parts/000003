    path = _dir(task_id) / "TASK.md"
    if not path.is_file():
        return None
    data, body = _parse(path.read_text(encoding="utf-8", errors="replace"))
    data["body"] = body
    return data


def task_ids() -> list[str]:
    root = _root() / "tasks"
    if not root.is_dir():
        return []
    return sorted(p.name for p in root.iterdir() if p.is_dir() and _ID.fullmatch(p.name))


