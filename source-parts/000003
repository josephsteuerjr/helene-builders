        calls = []
        real = self.box._load_state_locked

        def spy(path):
            calls.append(path.name)
            return real(path)
        return mock.patch.object(self.box, "_load_state_locked", side_effect=spy), calls

    def test_second_enumeration_reads_no_files(self):
