        fn drop(&mut self) {
            for key in ["RELAY_ARGUMENT_BYTES_LIMIT", "RELAY_ARGUMENT_WHITESPACE_RUN_LIMIT", "RELAY_MODEL_ATTEMPT_MS_LIMIT"] {
                std::env::remove_var(key);
