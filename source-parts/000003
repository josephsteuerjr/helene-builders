        _, body = people.read("vasya")
        keys = [people._loop_key(l) for l in (body.get(people.LOOPS, "")).splitlines()
                if l.strip()]
        self.assertEqual(len(keys), len(set(keys)), "roundtrip наплодил дублей")
        self.assertEqual(len(keys), 1)


