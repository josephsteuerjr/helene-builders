<script>
"use strict";
const tg = window.Telegram && Telegram.WebApp;
if (tg) { tg.ready(); tg.expand();
  if (tg.disableVerticalSwipes) tg.disableVerticalSwipes();   // фикс: апп больше не ездит с камерой
  else if ("isVerticalSwipesEnabled" in tg) tg.isVerticalSwipesEnabled = false;
}
const $ = (s, r) => (r || document).querySelector(s);
const esc = s => String(s == null ? "" : s).replace(/[&<>"]/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const hap = k => { try { tg && tg.HapticFeedback && tg.HapticFeedback.impactOccurred(k || "light"); } catch (e) {} };
function toast(msg, ms) { const t = $("#toast"); t.textContent = msg; t.classList.add("on");
  clearTimeout(t._h); t._h = setTimeout(() => t.classList.remove("on"), ms || 2200); }

async function api(path, opts) {
  const r = await fetch(path, Object.assign({}, opts, {
    headers: Object.assign({ "X-Telegram-Init-Data": tg ? tg.initData : "",
                             "Content-Type": "application/json" }, (opts || {}).headers || {}) }));
  if (!r.ok) throw new Error("HTTP " + r.status);
  return r.json();
}
const post = (p, body) => api(p, { method: "POST", body: JSON.stringify(body || {}) });

/* ---------- роутер: стек страниц + BackButton ---------- */
const stack = [];
function syncBack() { if (!tg || !tg.BackButton) return;
  stack.length ? tg.BackButton.show() : tg.BackButton.hide(); }
function open(id, onOpen) { const p = $("#p-" + id); if (!p) return;
  stack.push(id); p.classList.add("on"); syncBack(); hap();
  if (onOpen) onOpen(); }
function back() { const id = stack.pop(); if (id) $("#p-" + id).classList.remove("on");
  closeSheet(); syncBack(); }
if (tg && tg.BackButton) tg.BackButton.onClick(back);
document.addEventListener("click", e => {
  if (e.target.closest("[data-back]")) back();
  const r = e.target.closest("[data-refresh]");
  if (r) { hap(); sections[r.dataset.refresh] && sections[r.dataset.refresh](); }
});

/* ---------- шит ---------- */
function openSheet(html) { $("#sheetbody").innerHTML = html; $("#sheet").classList.add("on");
  $("#shade").classList.add("on"); }
function closeSheet() { $("#sheet").classList.remove("on"); $("#shade").classList.remove("on"); }
$("#shade").addEventListener("click", closeSheet);

/* ---------- хаб ---------- */
const TILES = [
  { id: "arch",     ic: "🕸️", nm: "Архитектура", sub: "3D-граф её кода" },
  { id: "pulse",    ic: "💓", nm: "Пульс",       sub: "…" },
  { id: "overview", ic: "🧭", nm: "Обзор",       sub: "намерения · задачи · нити · решения" },
  { id: "thoughts", ic: "💭", nm: "Мысли",       sub: "…" },
  { id: "tasks",    ic: "✅", nm: "Таски",       sub: "…" },
  { id: "props",    ic: "🛠️", nm: "Предложения", sub: "её правки — твой мёрж" },
  { id: "memory",   ic: "🗂️", nm: "Память",      sub: "люди · дневник · душа" },
  { id: "memgraph", ic: "🕸", nm: "Граф памяти", sub: "кто с кем связан" },
  { id: "actions",  ic: "🔨", nm: "Действия",    sub: "…" },
  { id: "contacts", ic: "👥", nm: "Контакты",    sub: "важные + отсутствие" },
  { id: "rooms",    ic: "🚪", nm: "Комнаты",     sub: "режимы · контекст" },
  { id: "mail",     ic: "✉️", nm: "Почта",       sub: "…" },
  { id: "server",   ic: "🖥️", nm: "Сервер",      sub: "…" },
  { id: "brain",    ic: "🧠", nm: "Мозг",        sub: "модели · ключи · фолбэк" },
  { id: "self",     ic: "🪞", nm: "Я",           sub: "версии души · деформации" },
  { id: "percept",  ic: "👁️", nm: "Восприятие",  sub: "рычаги · причины пропуска" },
  { id: "env",      ic: "🎛️", nm: "Параметры",   sub: "ручки поведения" },
  { id: "commits",  ic: "🌱", nm: "Коммиты",     sub: "история дома" },
  { id: "skills",   ic: "📚", nm: "Скиллы",      sub: "…" },
  { id: "logs",     ic: "📜", nm: "Логи",        sub: "praxis · mailbot · boot" },
];
const LOADERS = { arch: loadArch, pulse: loadPulse, overview: loadOverview, thoughts: loadThoughts, tasks: loadTasks, props: loadProps,
  memory: loadMemory, memgraph: loadMemGraph, actions: loadActions, contacts: loadContacts, rooms: loadRooms,
  mail: loadMail, server: loadServer, env: loadEnv, brain: loadBrain, self: loadSelf, percept: loadPercept,
  commits: loadCommits, skills: loadSkills, logs: loadLogs };
const sections = { pulse: loadPulse, overview: loadOverview, thoughts: loadThoughts, tasks: loadTasks, props: loadProps, mail: loadMail,
  contacts: loadContacts, rooms: loadRooms, memory: loadMemory, actions: loadActions, server: loadServer,
  brain: loadBrain, self: loadSelf, percept: loadPercept, arch: loadArch,
  logs: () => loadLogs(curLog) };
let ROLE = "owner";
const GUEST_TILES = ["arch", "memory", "actions", "pulse", "server", "commits", "skills"];
function renderTiles() {
  $("#tiles").innerHTML = TILES.filter(t => ROLE === "owner" || GUEST_TILES.includes(t.id)).map(t => `
  <button class="tile" data-t="${t.id}">
    <span class="badge" id="bdg-${t.id}"></span>
    <span class="ic">${t.ic}</span>
    <span class="nm">${t.nm}</span>
    <span class="sub" id="sub-${t.id}">${t.sub}</span>
  </button>`).join("");
}
renderTiles();
// Ф1.7: бейджи стреляют ПОСЛЕ ответа /me — гость не бьётся об owner-эндпоинты на старте
api("/api/panel/me").then(m => { if (m.role && m.role !== ROLE) { ROLE = m.role; renderTiles(); }
  homeBadges(); }).catch(() => homeBadges());
$("#tiles").addEventListener("click", e => { const b = e.target.closest("[data-t]");
  if (b) open(b.dataset.t, LOADERS[b.dataset.t]); });

function setSub(id, text) { const el = $("#sub-" + id); if (el && text) el.textContent = text; }
function setBadge(id, n) { const el = $("#bdg-" + id); if (!el) return;
  if (n > 0) { el.textContent = n > 99 ? "99+" : n; el.classList.add("on"); } else el.classList.remove("on"); }

async function homeBadges() {
  api("/api/panel/server").then(s => {
    $("#headcommit").textContent = s.head || "";
    const la = (s.loadavg || "").split(" ")[0], mem = s.mem || {};
    setSub("server", `load ${la || "?"} · RAM ${mem.available_mb || "?"}М свободно`);
    const fresh = s.logs && s.logs.praxis ? s.logs.praxis.age_sec : 1e9;
    $("#statusdot").className = "dot " + (fresh < 900 ? "ok" : "err");
  }).catch(() => { $("#statusdot").className = "dot err"; });
  api("/api/panel/pulse").then(p => {
    const n = (p.tasks || []).length;
    setSub("tasks", n ? `открытых: ${n}` : "открытых нет"); setBadge("tasks", n);
    const hb = p.heartbeat; let hbs = "хартбит: нет данных";
    if (hb && (hb.last || hb.last_ts)) hbs = "хартбит: " + String(hb.last || hb.last_ts).slice(0, 16);
    const ua = (p.unanswered || []).length;
    const vl = p.voice_log; setSub("pulse", (ua ? `✉ без ответа: ${ua} · ` : "") + (vl ? `лог ${fmtAge(vl.age_sec)} · ${hbs}` : hbs));
    setBadge("pulse", ua);
  }).catch(() => {});
  if (ROLE === "owner") api("/api/panel/overview").then(o => {
    const c = o.counts || {};
    setSub("overview", `намерения ${c.desires || 0} · задачи ${c.tasks || 0} · нити ${c.loops || 0}`);
    setBadge("overview", 0);
  }).catch(() => {});
  if (ROLE === "owner") api("/api/panel/thoughts?days=1").then(t => {
    const n = (t.items || []).length, ev = (t.items || []).filter(i => i.kind === "evaluator").length;
    setSub("thoughts", n ? `за сутки: ${n}${ev ? " · legacy: " + ev : ""}` : "за сутки тихо");
    setBadge("thoughts", ev);
  }).catch(() => {});
  if (ROLE === "owner") api("/api/inbox").then(m => {
    const items = m.items || [], nw = items.filter(i => i.status === "new").length;
    setSub("mail", items.length ? `в ящике: ${items.length}${nw ? " · новых: " + nw : ""}` : "ящик пуст");
    setBadge("mail", nw);
  }).catch(() => {});
  if (ROLE === "owner") api("/api/panel/proposals").then(p => {
    const n = p.pending || 0;
    setSub("props", n ? `ждут решения: ${n}` : "новых нет"); setBadge("props", n);
  }).catch(() => {});
  api("/api/panel/skills").then(s => setSub("skills", `в блокноте: ${(s.items || []).length}`)).catch(() => {});
  api("/api/panel/actions").then(a => {
    const today = new Date().toISOString().slice(5, 10);
    const n = (a.items || []).filter(i => i.day === today).length;
    setSub("actions", n ? `сегодня: ${n}` : "сегодня тихо");
  }).catch(() => {});
  if (ROLE === "owner") api("/api/panel/absence").then(a => {
    setSub("contacts", a.active ? `⏳ отсутствие до ${a.until}` : `важных: ${(a.contacts || []).length}`);
    setBadge("contacts", a.active ? 1 : 0);
  }).catch(() => {});
  if (ROLE === "owner") api("/api/panel/identity").then(d => {
    const sh = (d.shifts || [])[0];
    setSub("self", sh ? `сдвиг: ${String(sh.ts || "").slice(5, 16).replace("T", " ")}` : "версии души · нагрузка");
  }).catch(() => {});
  if (ROLE === "owner") api("/api/panel/perception").then(p => {
    const over = (p.knobs || []).filter(k => k.source !== "default" && k.source !== "env").length;
    const sk = Object.values(p.skips_today || {}).reduce((a, b) => a + b, 0);
    setSub("percept", `${over ? "рычагов её: " + over + " · " : ""}${sk ? "пропусков: " + sk : "пропусков нет"}`);
  }).catch(() => {});
  if (ROLE === "owner") api("/api/panel/llm").then(d => {
    const v = d.roles.voice || {}, ev = d.roles.evaluator || {};
    setSub("brain", `голос ${v.model || "?"} · вспомогательная ${ev.model || "?"}`);
    const warn = v.on_fallback || ev.on_fallback;
    const el = $("#bdg-brain");
    if (el) { if (warn) { el.textContent = "⚠"; el.classList.add("on"); } else el.classList.remove("on"); }
  }).catch(() => {});
}
const fmtAge = s => s < 90 ? s + "с" : s < 5400 ? Math.round(s / 60) + "м" : Math.round(s / 3600) + "ч";
setInterval(homeBadges, 60000);
(() => { const h = new URLSearchParams(location.search).get("s") || (location.hash || "").slice(1);
  if (h && LOADERS[h]) open(h, LOADERS[h]); })();

/* ---------- Архитектура (3D) ---------- */
const KIND_COLOR = { core: "#5b8cff", test: "#41c98a", soul: "#c78bff", skill: "#ffa94d",
  memory: "#e6c86e", web: "#ff6b81", doc: "#9aa4b2", md: "#c78bff" };
let G = null, GDATA = null;
function loadArch() {
  const wrap = $("#graphwrap");
  api("/api/panel/graph").then(g => {
    GDATA = g;
    const kinds = {};
    g.nodes.forEach(n => kinds[n.kind] = (kinds[n.kind] || 0) + 1);
    $("#legend").innerHTML = Object.keys(kinds).map(k =>
      `<i style="background:${KIND_COLOR[k] || "#888"}"></i>${k} ${kinds[k]}`).join("");
    $("#gnodes").innerHTML = g.nodes.map(n => `<option value="${esc(n.id)}">`).join("");
    if (G) { G.graphData({ nodes: g.nodes, links: g.links }); return; } // Ф1.8: её самоправки видны по ⟳
    G = ForceGraph3D()(wrap)
      .backgroundColor(getComputedStyle(document.body).getPropertyValue("--bg").trim() || "#0f1115")
      .graphData({ nodes: g.nodes, links: g.links })
      .nodeLabel(n => `${n.id}${n.doc ? " — " + esc(n.doc) : ""}`)
      .nodeColor(n => KIND_COLOR[n.kind] || "#888")
      .nodeVal(n => Math.max(1, Math.cbrt((n.size || 1) / 120)))
      .linkColor(l => l.kind === "reads" ? "#e6c86e" : l.kind === "indexed" ? "#ffa94d" : "#5b8cff")
      .linkOpacity(0.35)
      .linkWidth(l => Math.min(3, 0.5 + (l.weight || 1) * 0.3))
      .onNodeClick(n => { focusNode(n); openNode(n.id); })
      .onBackgroundClick(closeSheet);
    G.controls().dampingFactor = 0.12;
    setTimeout(() => G.zoomToFit(600, 40), 700);
  }).catch(e => toast("граф не загрузился: " + e.message));
}
function focusNode(n) {
  if (!G || n.x == null) return;
  const d = 130, r = 1 + d / Math.hypot(n.x, n.y, n.z || 1);
  G.cameraPosition({ x: n.x * r, y: n.y * r, z: (n.z || 1) * r }, n, 700);
}
$("#greset").addEventListener("click", () => { hap(); G && G.zoomToFit(600, 40); });
$("#gsearch").addEventListener("change", e => {
  const id = e.target.value.trim(); if (!GDATA || !G) return;
  const n = G.graphData().nodes.find(x => x.id === id);
  if (n) { focusNode(n); openNode(n.id); e.target.blur(); }
});

/* ---------- Граф памяти (PASS 8.6): люди/темы + рёбра из ## Связи и graph.md ---------- */
const MG_COLOR = { people: "#c78bff", topic: "#e6c86e" };
let MG = null;
function loadMemGraph() {
  api("/api/panel/memgraph").then(g => {
    const wrap = $("#memgraphwrap");
    const people = g.nodes.filter(n => n.kind === "people").length;
    $("#mglegend").innerHTML =
      `<i style="background:${MG_COLOR.people}"></i>люди ${people}` +
      `<i style="background:${MG_COLOR.topic}"></i>темы ${g.nodes.length - people}` +
      ` · рёбер ${g.links.length}`;
    if (!g.nodes.length) {
      wrap.innerHTML = `<div class="empty" style="padding-top:40vh">Граф пока пуст — связи появляются<br>
        из remember(relates_to=…) и «сна».</div>`;
      return;
    }
    const data = { nodes: g.nodes,
      links: g.links.map(l => ({ source: l.a, target: l.b, label: l.label })) };
    if (MG) { MG.graphData(data); return; }
    MG = ForceGraph3D()(wrap)
      .backgroundColor(getComputedStyle(document.body).getPropertyValue("--bg").trim() || "#0f1115")
      .graphData(data)
      .nodeLabel(n => `${esc(n.label)} (${n.kind === "people" ? "человек" : "тема"}, связей: ${n.degree})`)
      .nodeColor(n => MG_COLOR[n.kind] || "#888")
      .nodeVal(n => Math.max(1, 1 + n.degree * 0.8))
      .linkColor(() => "#8a919e")
      .linkOpacity(0.4)
      .linkLabel(l => esc(l.label || ""))
      .onNodeClick(n => { mgFocus(n); openMemNode(n); })
      .onBackgroundClick(closeSheet);
    MG.controls().dampingFactor = 0.12;
    setTimeout(() => MG.zoomToFit(600, 40), 700);
  }).catch(e => toast("граф памяти не загрузился: " + e.message));
}
function mgFocus(n) {
  if (!MG || n.x == null) return;
  const d = 110, r = 1 + d / Math.hypot(n.x, n.y, n.z || 1);
  MG.cameraPosition({ x: n.x * r, y: n.y * r, z: (n.z || 1) * r }, n, 700);
}
$("#mgreset").addEventListener("click", () => { hap(); MG && MG.zoomToFit(600, 40); });
async function openMemNode(n) {
  if (n.kind === "people") {
    openSheet(`<div class="skel"></div>`);
    try {
      const d = await api("/api/panel/memory/read?path=" + encodeURIComponent("memory/people/" + n.id + ".md"));
      openSheet(`<h2 style="font-size:15px">${esc(n.label)}</h2>
        <pre class="code" style="white-space:pre-wrap">${esc(d.text || "")}</pre>`);
    } catch (e) { openSheet(`<div class="empty">досье не прочиталось: ${esc(e.message)}</div>`); }
    return;
  }
  const edges = (MG ? MG.graphData().links : []).filter(l =>
    (l.source.id || l.source) === n.id || (l.target.id || l.target) === n.id);
  openSheet(`<h2 style="font-size:15px">${esc(n.label)} <span class="pill gray">тема</span></h2>
    <div class="card" style="margin-top:8px">${edges.map(l => {
      const a = l.source.label || l.source.id || l.source, b = l.target.label || l.target.id || l.target;
      return `<div class="row"><span class="small">${esc(a)} — ${esc(b)}</span>
        <span class="v small muted">${esc(l.label || "связаны")}</span></div>`; }).join("")
      || `<div class="muted small">рёбер нет</div>`}</div>`);
}

async function openNode(rel) {
  openSheet(`<div class="skel"></div><div class="skel"></div>`);
  let f; try { f = await api("/api/panel/file/" + encodeURIComponent(rel).replace(/%2F/g, "/")); }
  catch (e) { openSheet(`<div class="empty">не прочитался: ${esc(e.message)}</div>`); return; }
  const chips = [f.kind, fmtSize(f.size), f.loc ? f.loc + " строк" : "", f.funcs && f.funcs.length ? f.funcs.length + " функц." : ""]
    .filter(Boolean).map(c => `<span class="pill gray">${esc(c)}</span>`).join(" ");
  const rels = [];
  const relBlock = (title, arr) => (arr && arr.length) &&
    rels.push(`<div class="row"><span class="k">${title}</span><span class="v small">${arr.map(esc).join(", ")}</span></div>`);
  relBlock("импортирует", f.imports); relBlock("импортируют его", f.imported_by);
  relBlock("читает", f.reads); relBlock("читают его", f.read_by);
