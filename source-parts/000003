    rows: list[dict] = []
    previous = ""
    try:
        lines = LEDGER.read_text(encoding="utf-8").splitlines()
    except FileNotFoundError:
        return []
    except OSError as exc:
        raise RuntimeError(f"moderation ledger unreadable: {exc}") from exc
