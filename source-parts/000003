_BROKEROPS = "serverd/brokerops.py"
# Вырез описан в brokerops одной f-строкой. Держать её копию здесь нельзя: копия пережила
# оригинал ровно один раз и врала до сегодня. Плейсхолдеры разворачиваем по смыслу выражения,
# а не по номеру — иначе перестановка слов в чужой строке молча превратит метку в кашу.
_CUT_MARKER_RE = re.compile(r'\+\s*f"\\n(…[^"]*…)\\n"')
_CAP_CALL_RE = re.compile(r"_cap\([^\n]*?,\s*(\d+)\)")
_ACTION_RE = re.compile(r'action == "([a-z_]+)"')


def _cut_marker() -> str:
    """Метка выреза — прочитанная из brokerops, с числами, замененными на N/M/K."""
    match = _CUT_MARKER_RE.search(_source_text(_BROKEROPS))
    if not match:
        return "не прочиталось"

    def _slot(m: re.Match) -> str:
        expr = m.group(1)
        if "-" in expr and "len(" in expr:
            return "N"           # сколько вырезано
        if "len(" in expr:
            return "M"           # сколько было всего
        if expr.strip() == "limit":
            return "K"           # сам кап
        return "…"
    return re.sub(r"\{([^{}]*)\}", _slot, match.group(1))


