      : token.startsWith("files.") ? "computer.files"
        : token.startsWith("desktop.") ? "computer.apps"
          : "computer.read";
    const allowed = hasScope(required, snapshot);
    button.hidden = !allowed;
    button.disabled = !allowed;
  });
}

