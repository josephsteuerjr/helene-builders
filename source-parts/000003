# --------- follow-up: где кончается моя память и начинается его почта
#
# Всё ниже читается из telegram_followups.py и раннера, а не пересказывается. Причина не
# в педантизме: пока писался этот рельс, механику переписывал сосед — и запись, обещающая
# «письмо уходит только по заказу» до того, как заказ появился в коде, была бы ровно той
# ложью, ради снятия которой рельс и заводится. Каждая половина спрашивает у кода, что
# сейчас правда, и обе ветки ответа написаны.
_FOLLOWUPS = "telegram_followups.py"
_FOLLOWUP_LOOSE_RE = re.compile(r"explicit_only\s*=\s*False")
_FOLLOWUP_ACTIONS_RE = re.compile(r'return "action должен быть ([^"]+)\."')


# Память по САМОМУ ТЕКСТУ, а не по mtime файла. Ключ — mtime был бы короче, но тесты
# подменяют `_source_text` лямбдой (так проверяются ветки «судью не зовёт никто» и «файл
# не прочитался»), и кэш по mtime отдал бы им настоящий agent.py — то есть проверка
# краснела бы не там, где неправда. Хэш строки питон запоминает в самом объекте, а
# сравнение `==` для одного и того же объекта коротит по идентичности, поэтому повторный
# вызов на кэшированном исходнике стоит ноль.
_CODE_ONLY_CACHE: dict[int, tuple[str, str]] = {}


def _code_only(text: str) -> str:
    """Исходник без строчных комментариев.

    Разница та же, что в сверке имён рычагов: `#` — записка тому, кто правит файл, и в ней
    цитата снятой строки («здесь стояло explicit_only=False») уместна и полезна. Если читать
    её как живой код, рельс объявит ей автоматизм, которого уже нет, — то есть соврёт ровно
    в момент починки. Наличие механики спрашиваем только у кода.

    15.08: появился кэш. Причина считанная, а не гигиеническая — эта функция чистит
    мегабайтный agent.py, и после того как сверка значений манифеста поехала в STATE
    каждого хода, она стала зваться десяток раз подряд на одном и том же тексте.
    """
    src = text or ""
    key = hash(src)
    hit = _CODE_ONLY_CACHE.get(key)
    if hit is not None and hit[0] == src:
        return hit[1]
    out = re.sub(r"(?m)#.*$", "", src)
    if len(_CODE_ONLY_CACHE) > 32:     # словарь без вытеснения: держим потолок, не LRU
        _CODE_ONLY_CACHE.clear()
    _CODE_ONLY_CACHE[key] = (src, out)
    return out


def _followup_ttl() -> tuple[float | None, str]:
    """(срок жизни следа, имя рычага). Имя рычага тоже читается: вписанное руками имя
    переживает переименование соседа молча — на этом уже обжигались дважды за день."""
    src = _code_only(_source_text(_FOLLOWUPS))
    # Не первое попавшееся имя: в этом файле уже есть PRAXIS_BASE, и он не имеет к сроку
    # никакого отношения — берём то, что действительно похоже на срок.
    env = next((n for n in re.findall(r"\bPRAXIS_[A-Z0-9_]+\b", src) if "TTL" in n), "")
    live = _live("telegram_followups", "TRACE_TTL_SEC")
    if isinstance(live, (int, float)) and not isinstance(live, bool):
        return float(live), env
    number = (_num_in(src, r"(?m)^TRACE_TTL_SEC = ([\d.]+)")
              or _num_in(src, r"def _trace_ttl\(\)[\s\S]*?return ([\d.]+)"))
    return number, env


def _num_in(text: str, pattern: str) -> float | None:
    """Число из уже прочитанного текста. Отдельно от `_from_source`, потому что здесь
    читается ОЧИЩЕННЫЙ от комментариев исходник: закомментированный старый кап не должен
    выдаваться за живой."""
    match = re.search(pattern, text)
    if not match:
        return None
    try:
        return float(match.group(1))
    except (TypeError, ValueError):
        return None


def _followup_report_gate() -> str:
    """Кто сегодня решает, что ответ на нить уедет владельцу письмом."""
    src = _code_only(_source_text(_FOLLOWUPS))
    runner = _code_only(_source_text(_RUNNER))
    if not src.strip() or not runner.strip():
        return "⚠ леджер нитей не прочитался — кому уходит письмо, отсюда не видно"
    if "notify_owner" in src:
        head = ("письмо уходит ТОЛЬКО по нити, где отчёт заказан (notify_owner); остальные "
                "нити — мой след и остаются у меня")
    else:
        head = ("⚠ письмо уходит по КАЖДОЙ отвеченной нити: признака «отчёт заказан» в леджере "
                "нет вовсе — след и почта владельцу здесь одно и то же")
    who = []
    if _FOLLOWUP_LOOSE_RE.search(runner):
        who.append("нить заводит ЛЮБАЯ последняя реплика владельца в его ЛС (explicit_only=False — "
                   "просьбы словами не требуется)")
    if "Praxis initiative from social pulse" in runner:
        who.append("и каждая моя реплика из часового пульса")
    if not who:
        who.append("нить с отчётом заводится на явную просьбу владельца словами (wants_followup)")
    return head + "; " + ", ".join(who)


def _followup_trace_life() -> str:
    ttl, env = _followup_ttl()
    ordered = ("; заказанный отчёт по возрасту не гаснет"
               if "notify_owner" in _code_only(_source_text(_FOLLOWUPS)) else "")
    if ttl is None:
        return ("срока жизни у следа нет: нить без ответа висит pending, пока я не отменю её "
                "сама — по возрасту гаснут только те, где срок назван словами в самой просьбе "
                "(explicit_expiry_seconds)")
    lever = f" ({env}, читается на импорте: смена требует рестарта)" if env else ""
    return f"след без ответа гаснет через {ttl / 3600:g}ч{lever}" + ordered


def _followup_caps() -> str:
    src = _code_only(_source_text(_FOLLOWUPS))
    runner = _code_only(_source_text(_RUNNER))
    # Кап ленты может жить и константой (её сосед вводит вместе с разделением), и дефолтом
    # сигнатуры context() — связывает тот, который есть, поэтому спрашиваем оба.
    lenta = (_neighbour_num("telegram_followups", "CONTEXT_LIMIT", _FOLLOWUPS,
                            r"(?m)^CONTEXT_LIMIT = (\d+)")
             or _num_in(src, r"def context\(self, \*, limit: int = (\d+)\)"))
    per_tick = _num_in(runner, r"for item in pending\[:(\d+)\]")
    keep = _num_in(src, r"(?m)^_SETTLED_KEEP = (\d+)")
    # 04.08: в строке ленты её собственный текст и чужая просьба разведены — «я сказала»
    # против «повод отправки». Рез у обоих один, и связывать надо тот, который в этой
    # строке главный: её слова. Пока он читался по ярлыку «повод», сверка держалась за
    # формулировку, которая называла её речь причиной.
    row = _num_in(src, r"я сказала: «\{said\[:(\d+)\]\}»")
    excerpt = _num_in(runner, r'response\.get\("text"\) or "\(без текста\)"\)\[:(\d+)\]')
    return (f"в ленте пульса не больше {_sec(lenta, ' нитей')} (остальные не показываются "
            f"вовсе), за тик не больше {_sec(per_tick, ' писем')}, история хранит "
            f"{_sec(keep, ' закрытых нитей')}; в строке ленты мои слова (и повод, если "
            f"слов нет) режутся до {_sec(row, ' симв')}, в письме ответ — до "
            f"{_sec(excerpt, ' симв')}")


def _followup_letter_face() -> str:
    src = _code_only(_source_text(_FOLLOWUPS))
