def fake_embed(text: str) -> list[float]:
    """Детерминированный bag-of-words вектор: общие слова -> близкие векторы."""
    dim = 64
    v = [0.0] * dim
    for tok in re.findall(r"\w+", (text or "").lower()):
        v[hash(tok) % dim] += 1.0
    if not any(v):
        v[0] = 1.0
    return v


