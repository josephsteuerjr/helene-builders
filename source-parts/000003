    @contextmanager
    def locked(self):
        self.root.mkdir(parents=True, exist_ok=True, mode=0o700)
        if self.root.is_symlink():
            raise XttsError('invalid_generation_store')
        with self.lock, (self.root / '.lock').open('a+b') as lock:
            if os.name == 'posix':
