def _fresh_value(rail_id: str) -> str:
    """Значение рельса ТОЙ ЖЕ функцией, которая пишет его в файл (registry(only=…))."""
    for row in registry(only=(rail_id,)):
        if row["id"] == rail_id:
            return str(row["value"])
    return ""


def _place_key_by_knowledge_value() -> str:
    """Строится ли ключ МЕСТА по знанию о комнате — считано из живого кода.

    ⚠ Этот рельс родился из трёх потерянных недель, и потому меряет КОД, а не намерение.
    25.07 `route_for_message` научился главному: обычная супергруппа это ОДНА комната, и
    цепочка ответов не становится ключом хранения. Знание тоже было — реестр держал
    вердикт по живому ответу Telegram. Не хватало одного: знание не доезжало до
    построения ключа, и рядом стояла расписка «перекладка ключа однажды делалась по
    знанию». «Однажды» простояло три недели, потому что ничто не умело сказать, что
    ожидание кончилось.

    Поэтому меряем ровно то, что тогда молчало: сколько мест строят ключ и сколько из
    них СПРАШИВАЮТ. Появится четвёртое, не спросившее, — значение разойдётся с
    манифестом, и сверка скажет об этом на первом же ходе.
    """
    src = _code_only(_source_text("mtproto_runner.py"))
    if not src:
        return ("⚠ исходник раннера не прочитался — строится ли ключ по знанию, отсюда "
                "НЕ ВИДНО. Это «не знаю», а не «как вчера»")
    sites = src.count("telegram_topics.route_for_message(")
    asking = (src.count("is_forum=_known_forum(")
              + src.count("_known_forum(event.chat_id"))
    asking = min(asking, sites)
    live = src.count('_known_forum(event.chat_id, msg, getattr(event, "chat", None))')
    head = f"мест построения ключа {sites}, спрашивают знание {asking}"
    if sites and asking >= sites:
        head += "; живой флаг комнаты читают " + str(live) + " из них"
    else:
        head += " — ⚠ РАСХОЖДЕНИЕ: часть путей режет комнату вслепую"
    return (head + ". Порядок: прямой ответ Telegram (объект апдейта, не `min`) сильнее "
            "накопленного вердикта; реестр остаётся истории — у комнаты бывают эпохи, и "
            "старое сообщение роутится режимом своего времени")

def _witness_chat_reply_contract() -> tuple[str, ...] | None:
    """Сверяем только структуру; live env-положение рычага честно показывается, но не gate'ites.

    ⚠ ЗНАЧОК ИЩЕТСЯ ВЕЗДЕ, А НЕ В НАЧАЛЕ. `_chat_reply_contract_structure` собирает
    строку из трёх кусков и ВСЕГДА начинает её с `проверяемая структура: `, а свои
    три «не прочиталось» кладёт в СЕРЕДИНУ (`rails.py:1039-1048`). Поэтому прежнее
    `value.startswith("⚠")` было мёртвым кодом: непрочитанный `work_loop.py` или
    `agent.py` ехал дальше как ПРОВЕРЕННЫЙ факт, и ближайший `sync_md()` вписывал
    ⚠-текст в `soul/rails.md`, объявляя его свежим.

    Сосед `_witness_place_key` тем же приёмом пользуется правильно: его значение
    начинается со значка, когда не прочиталось. Здесь строитель другой — значит и
    проверка должна быть другой.

    `None` уходит в `unchecked` (`manifest_drift`, :2749) — названную категорию
    «сверять было нечем». Это и есть честный исход, ради которого ветка заводилась.
    """
    value = _chat_reply_contract_structure()
    return None if (not value or "⚠" in value) else (value,)


def _witness_place_key() -> tuple[str, ...] | None:
    """Ключ места — значение целиком: оно всё считано из исходника раннера."""
    value = _fresh_value("place_key_by_knowledge")
    return None if (not value or value.startswith("⚠")) else (value,)


VALUE_WITNESSES = {
    "chat_reply_contract": _witness_chat_reply_contract,
    "place_key_by_knowledge": _witness_place_key,
}


def manifest_drift() -> dict:
    """Отстал ли файл манифеста от кода — СОСТАВОМ рельсов и ЗНАЧЕНИЕМ у свидетелей.

    Нужна потому, что soul/rails.md пишет только сон (sleep.py), а сон отменяется по
    просьбе «останови фон» БЕЗ метки попытки — то есть манифест может замереть на
    произвольный срок и молча описывать вчерашний дом. Такое отставание она обязана
    видеть в той же строке, где видит счёт рельсов.

    ⚠ Следствие, которое надо знать заранее: правка agent.py в судимой зоне сдвигает
    адрес судьи, и файл СТАНОВИТСЯ отставшим — это правда, а не флап. Лечится ровно
    одним: `rails.sync_md()` после такой правки (в проде это делает ночной сон).

    -> {"missing": [...в коде есть, в файле нет...], "stale": [...в файле есть,
        в коде нет — это уже обещание несуществующего...], "value_stale": [...id есть,
        а значение врёт...], "unchecked": [...свидетель не посчитался: «не знаю», а не
        «совпало»...], "ok": bool}
    """
    code = {r["id"] for r in registry(with_values=False)}
    try:
        text = RAILS_MD.read_text(encoding="utf-8")
    except OSError:
        return {"missing": sorted(code), "stale": [], "value_stale": [],
                "unchecked": sorted(VALUE_WITNESSES), "ok": False, "file": False}
    on_disk = manifest_ids(text)
    said = manifest_values(text)
    value_stale: list[str] = []
    unchecked: list[str] = []
    for rail_id in sorted(VALUE_WITNESSES):
        if rail_id not in code or rail_id not in on_disk:
            continue          # расхождение состава уже названо выше, не дублируем его
        try:
            witness = VALUE_WITNESSES[rail_id]()
        except Exception:
            log.debug("свидетель значения %s не посчитался", rail_id, exc_info=True)
            witness = None
        if witness is None:
            unchecked.append(rail_id)
            continue
        mine = said.get(rail_id) or ""
        if any(str(fact) not in mine for fact in witness):
            value_stale.append(rail_id)
    return {"missing": sorted(code - on_disk), "stale": sorted(on_disk - code),
            "value_stale": value_stale, "unchecked": unchecked,
            "ok": code == on_disk and not value_stale, "file": True}


def sync_md() -> bool:
    """Записать манифест, только если изменился. True = переписала."""
    try:
        text = render_md()
        try:
            if RAILS_MD.read_text(encoding="utf-8") == text:
                return False
        except OSError:
            pass
        RAILS_MD.parent.mkdir(parents=True, exist_ok=True)
        tmp = RAILS_MD.with_suffix(".md.tmp")
        tmp.write_text(text, encoding="utf-8")
        tmp.replace(RAILS_MD)
        return True
    except Exception:
        log.warning("rails.sync_md не смог записать манифест", exc_info=True)
        return False


