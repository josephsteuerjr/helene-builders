class CountingFake:
    def __init__(self, reply="цель дня"):
        self.calls = 0
        outer = self

        class _M:
            def create(_s, **kw):
                outer.calls += 1
                outer.last = kw
                return FakeResp(outer.reply)
        self.reply = reply
        self.messages = _M()


