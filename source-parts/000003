        rows = [self._msg(i, f"реплика {i}") for i in range(1, 21)]
        self._compact(rows)
        counts = self._count(lambda: ml.rebuild_state(ROOM))
        self.assertEqual(counts["index"], 1, counts)
        self.assertEqual(counts["parse"], 1, counts)



