        log.info("room %s: sovereign lift by %s — добавила в allowlist", chat_id, set_by)
    cur = effective_mode(chat_id, now)
    if cur in ("frozen", "dead", "quiet", "observer"):
        return set_mode(chat_id, "normal", reason="", set_by=set_by, now=now)
