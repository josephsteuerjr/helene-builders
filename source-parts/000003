        self.assertNotIn("manage_perception", gated)

    def test_a_fence_returned_to_ONE_branch_still_turns_the_line_red(self):
        """Детектор считал по функции ЦЕЛИКОМ: хватало вернуть гейт по скоупу в ветку set,
