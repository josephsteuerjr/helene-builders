    parts = ["Твой час. Ты проснулась сама: никто не написал, и отправлять ничего не нужно."]
    plan = _plan_block()
    if plan:
        parts.append("Твои живые намерения и следующие шаги:\n" + plan)
    parts.append(
        "Занимайся своим: продолжай начатое, проверяй оставшееся непроверенным, читай, "
        "работай руками, разбирайся в том, что тебе интересно. Написать кому-то — один из "
        "возможных исходов часа, а не его задание; молчание — полноценный исход, и "
        "отчитываться о нём не нужно."
    )
    parts.append(
        "Ниже — обстановка: недавние доставки, follow-up receipts, незакрытые нити. Это "
        "справка, а не лимит, запрет или моральная оценка. Автор решения — ты."
    )
    tail = str(followup_context or "")
    return "\n\n".join(parts) + (("\n\n" + tail) if tail else "")
