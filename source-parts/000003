  border: 1px solid rgba(255, 255, 255, .22);
  border-radius: 999px;
  background: linear-gradient(145deg, rgba(var(--violet-rgb), .95), rgba(var(--blue-rgb), .82));
  box-shadow: 0 5px 18px rgba(var(--violet-rgb), .28);
  font-size: 10px;
  font-weight: 800;
}

.signal-bars {
  position: absolute;
  top: 17px;
  right: 16px;
  height: 25px;
  display: flex;
  align-items: flex-end;
  gap: 3px;
}

.signal-bars i {
  width: 3px;
  border-radius: 3px;
  background: var(--muted);
}

.signal-bars i:nth-child(1) { height: 7px; }
.signal-bars i:nth-child(2) { height: 13px; }
.signal-bars i:nth-child(3) { height: 20px; }
.signal-bars.is-online i { background: var(--green); box-shadow: 0 0 8px rgba(var(--green-rgb), .42); }

.feed-section {
  margin-bottom: 12px;
}

.signal-feed {
  min-height: 92px;
  padding: 5px 15px;
  border-radius: var(--radius-lg);
}

.signal-row {
  position: relative;
  min-height: 61px;
  padding: 11px 0;
  display: grid;
  grid-template-columns: 34px minmax(0, 1fr) auto;
  align-items: center;
  gap: 10px;
  transition: background .18s var(--ease-out);
}

/* inset-разделитель по-эппловски: начинается от текста, а не под иконкой */
.signal-row:not(:last-child)::after {
  content: "";
  position: absolute;
  left: 44px;
  right: 0;
  bottom: 0;
  height: 1px;
  background: rgba(255, 255, 255, .06);
}

.signal-row:active {
  background: rgba(255, 255, 255, .04);
}

.signal-row__dot {
  width: 32px;
  height: 32px;
  display: grid;
  place-items: center;
  color: var(--blue);
  border-radius: 11px;
  background: rgba(var(--blue-rgb), .09);
}

.signal-row__dot .icon {
  width: 17px;
  height: 17px;
}

.signal-row__copy {
  min-width: 0;
  display: grid;
}

.signal-row__copy strong,
.list-copy strong {
  overflow: hidden;
  font-size: 12.5px;
  font-weight: 650;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.signal-row__copy small,
.list-copy small {
  overflow: hidden;
  color: var(--muted);
  font-size: 10.5px;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.signal-row time {
  color: var(--muted);
  font-size: 9.5px;
  font-variant-numeric: tabular-nums;
}

.delivery-card {
  position: relative;
  padding: 15px 1px;
  border-bottom: 1px solid rgba(255, 255, 255, .065);
}

.delivery-card:last-child {
  border-bottom: 0;
}

.delivery-card.is-unread::before {
  content: "";
  position: absolute;
  top: 19px;
  left: -8px;
  width: 3px;
  height: 30px;
  border-radius: 999px;
  background: linear-gradient(var(--cyan), var(--violet));
  box-shadow: 0 0 15px rgba(var(--violet-rgb), .42);
}

.delivery-card__head {
  display: grid;
  grid-template-columns: 34px minmax(0, 1fr) auto;
  align-items: center;
  gap: 10px;
}

.delivery-card__sigil {
  width: 32px;
  height: 32px;
  display: grid;
  place-items: center;
  color: var(--cyan);
  border-radius: 11px;
  background: rgba(var(--cyan-rgb), .09);
}

.delivery-card__sigil .icon {
  width: 17px;
  height: 17px;
}

.delivery-card__title {
  min-width: 0;
  display: grid;
}

.delivery-card__title strong {
  overflow: hidden;
  font-size: 13px;
  font-weight: 680;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.delivery-card__title small {
  color: var(--muted);
  font-size: 10.5px;
}

.delivery-card__result,
.delivery-card__detail {
  margin: 10px 0 0 44px;
  color: var(--text-soft);
  font-size: 12px;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.delivery-card__result {
  color: var(--text);
  line-height: 1.52;
}

.delivery-card__detail strong {
  color: var(--muted);
  font-size: 10px;
  letter-spacing: .03em;
  text-transform: uppercase;
}

.delivery-card__actions {
  margin: 12px 0 0 44px;
  display: flex;
  flex-wrap: wrap;
  gap: 8px 14px;
}

.file-workbench {
  display: grid;
  gap: 14px;
}

.file-operation {
  padding: 17px;
  border: 1px solid var(--stroke);
  border-radius: var(--radius-md);
  background: var(--surface-soft);
}

.file-operation h3 {
  margin: 0 0 10px;
  font-size: 14px;
}

.file-operation + .file-operation {
  box-shadow: inset 0 1px rgba(255, 255, 255, .035);
}

.empty-state,
.error-state,
.loading-state {
  min-height: 118px;
  padding: 25px 20px;
  display: grid;
  place-items: center;
  align-content: center;
  gap: 5px;
  color: var(--muted);
  border: 1px dashed rgba(255, 255, 255, .11);
  border-radius: var(--radius-lg);
  text-align: center;
}

.empty-state .icon,
.error-state .icon {
  width: 25px;
  height: 25px;
  margin-bottom: 4px;
}

.error-state {
  color: var(--red);
  border-color: rgba(var(--red-rgb), .2);
}

.empty-state strong,
.error-state strong {
  color: var(--text-soft);
  font-size: 13px;
}

.empty-state small,
.error-state small {
  max-width: 340px;
  color: var(--muted);
  font-size: 11px;
}

.segmented {
  position: sticky;
  z-index: 8;
  top: calc(66px + var(--safe-top));
  margin: -4px 0 15px;
  padding: 4px;
  display: flex;
  gap: 2px;
  overflow-x: auto;
  border: 1px solid var(--stroke);
  border-radius: 16px;
  background: rgba(12, 16, 25, .67);
  -webkit-backdrop-filter: blur(20px) saturate(145%);
  backdrop-filter: blur(20px) saturate(145%);
  scrollbar-width: none;
}

:root[data-theme="light"] .segmented {
  background: rgba(240, 244, 251, .72);
}

.segmented::-webkit-scrollbar { display: none; }

.segmented__button {
  min-width: max-content;
  min-height: 40px;
  padding: 0 13px;
  color: var(--muted);
  border-radius: 12px;
  background: transparent;
  font-size: 11px;
  font-weight: 700;
  transition: color .2s, background .2s, transform .2s var(--spring);
}

.segmented__button.is-active {
  color: var(--text);
  background: rgba(255, 255, 255, .09);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .07);
}

/* Сводка над списком прогонов: числа истории + фраза о границе среза (03.08.2026). */
.runs-summary {
  margin-bottom: 11px;
  padding: 13px 14px;
  display: grid;
  gap: 8px;
  border: 1px solid var(--stroke);
  border-radius: var(--radius-md);
}

.runs-summary__metrics {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(58px, 1fr));
  gap: 6px;
}

.runs-summary__metrics span {
  min-width: 0;
  padding: 7px;
  display: grid;
  border-radius: 10px;
  background: rgba(255, 255, 255, .04);
  text-align: center;
}

.runs-summary__metrics strong {
  overflow: hidden;
  font-size: 12px;
  text-overflow: ellipsis;
  /* Пять чисел стоят в ряд и меняются на каждом снимке: пропорциональные цифры дают
     дёрганье ширины колонок. tabular-nums держит 2120 и 1990 в одной сетке. */
  font-variant-numeric: tabular-nums;
}

.runs-summary__metrics small {
  color: var(--muted);
  font-size: 8.5px;
  text-transform: uppercase;
}

.runs-summary__note {
  color: var(--muted);
  font-size: 10.5px;
  line-height: 1.45;
}

.stack-list {
  display: grid;
  gap: 9px;
}

.stack-card {
  min-height: 76px;
  padding: 13px 14px;
  display: flex;
  align-items: center;
  gap: 12px;
  overflow: hidden;
  color: var(--text);
  border: 1px solid var(--stroke);
  border-radius: var(--radius-md);
  background: var(--surface);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .055), 0 8px 24px rgba(0, 0, 0, .11);
  -webkit-backdrop-filter: blur(17px) saturate(140%);
  backdrop-filter: blur(17px) saturate(140%);
  text-align: left;
  transition: transform .25s var(--spring), border-color .2s, background .2s;
}

.stack-card:hover {
  border-color: var(--stroke-bright);
  background: var(--surface-hover);
}

.stack-card__icon {
  width: 42px;
  height: 42px;
  flex: 0 0 auto;
  display: grid;
  place-items: center;
  color: var(--blue);
  border-radius: 14px;
  background: rgba(var(--blue-rgb), .095);
}

.stack-card__icon .icon {
  width: 21px;
  height: 21px;
}

.stack-card__body,
.list-copy {
  min-width: 0;
  flex: 1;
  display: grid;
  gap: 2px;
}

.stack-card__body strong {
  overflow: hidden;
  font-size: 13px;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.stack-card__body small {
  overflow: hidden;
  color: var(--muted);
  font-size: 10.5px;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.stack-card__meta {
  flex: 0 0 auto;
  display: grid;
  justify-items: end;
  gap: 5px;
}

.artifact-preview {
  margin: 14px 0 0;
  overflow: hidden;
  border: 1px solid var(--stroke-bright);
  border-radius: var(--radius-lg);
  background: rgba(2, 5, 11, .62);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .06), 0 18px 50px rgba(0, 0, 0, .24);
}

.artifact-preview img {
  width: 100%;
  max-height: min(62vh, 760px);
  display: block;
  object-fit: contain;
  background: rgba(0, 0, 0, .34);
}

.artifact-preview figcaption {
  padding: 11px 13px;
  display: grid;
  gap: 2px;
  border-top: 1px solid var(--stroke);
}

.artifact-preview figcaption strong {
  overflow: hidden;
  font-size: 12px;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.artifact-preview figcaption small {
  color: var(--muted);
  font: 9.5px/1.4 var(--mono);
}

.status-pill {
  min-height: 23px;
  padding: 3px 9px 3px 8px;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  color: var(--text-soft);
  border: 1px solid rgba(255, 255, 255, .08);
  border-radius: 999px;
  background: rgba(255, 255, 255, .055);
  font-size: 9px;
  font-weight: 600;
  letter-spacing: .06em;
  text-transform: uppercase;
  white-space: nowrap;
}

.status-pill::before {
  content: "";
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--muted);
}

.status-pill[data-tone="green"] { color: var(--green); background: rgba(var(--green-rgb), .085); }
.status-pill[data-tone="green"]::before {
  background: var(--green);
  box-shadow: 0 0 7px rgba(var(--green-rgb), .5);
  animation: pill-breathe 2.4s ease-in-out infinite;
}
@keyframes pill-breathe { 50% { opacity: .5; transform: scale(.82); } }
.status-pill[data-tone="violet"] { color: var(--violet); background: rgba(var(--violet-rgb), .09); }
.status-pill[data-tone="violet"]::before { background: var(--violet); }
.status-pill[data-tone="gold"] { color: var(--gold); background: rgba(var(--gold-rgb), .09); }
.status-pill[data-tone="gold"]::before { background: var(--gold); }
.status-pill[data-tone="red"] { color: var(--red); background: rgba(var(--red-rgb), .09); }
.status-pill[data-tone="red"]::before { background: var(--red); }
.status-pill[data-tone="cyan"] { color: var(--cyan); background: rgba(var(--cyan-rgb), .09); }
.status-pill[data-tone="cyan"]::before { background: var(--cyan); }

.run-progress {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 2px;
  overflow: hidden;
  background: rgba(255, 255, 255, .035);
}

.run-progress i {
  display: block;
  width: var(--progress, 35%);
  height: 100%;
  border-radius: 2px;
  background: linear-gradient(90deg, var(--violet), var(--cyan));
  box-shadow: 0 0 12px rgba(var(--cyan-rgb), .42);
  transition: width .7s var(--ease-out);
}

.run-progress i[data-progress="0"] { --progress: 0%; }
.run-progress i[data-progress="1"] { --progress: 10%; }
.run-progress i[data-progress="2"] { --progress: 20%; }
.run-progress i[data-progress="3"] { --progress: 30%; }
.run-progress i[data-progress="4"] { --progress: 40%; }
.run-progress i[data-progress="5"] { --progress: 50%; }
.run-progress i[data-progress="6"] { --progress: 60%; }
.run-progress i[data-progress="7"] { --progress: 70%; }
.run-progress i[data-progress="8"] { --progress: 80%; }
.run-progress i[data-progress="9"] { --progress: 90%; }
.run-progress i[data-progress="10"] { --progress: 100%; }

.device-hero {
  min-height: 160px;
  padding: 20px;
  overflow: hidden;
  border-radius: var(--radius-xl);
  background:
    radial-gradient(circle at 88% 18%, rgba(var(--cyan-rgb), .18), transparent 38%),
    linear-gradient(145deg, rgba(255, 255, 255, .07), transparent 48%),
    var(--surface);
}

.device-head {
  display: flex;
  align-items: center;
  gap: 13px;
}

.device-orb {
  position: relative;
  width: 52px;
  height: 52px;
  flex: 0 0 auto;
  display: grid;
  place-items: center;
  color: var(--cyan);
  border: 1px solid rgba(var(--cyan-rgb), .22);
  border-radius: 18px;
  background: rgba(var(--cyan-rgb), .09);
  box-shadow: 0 0 35px rgba(var(--cyan-rgb), .1), inset 0 1px 0 rgba(255, 255, 255, .09);
}

.device-orb.is-online::after {
  content: "";
  position: absolute;
  right: 4px;
  bottom: 4px;
  width: 8px;
  height: 8px;
  border: 2px solid var(--surface-strong);
  border-radius: 50%;
  background: var(--green);
}

.device-copy {
  min-width: 0;
  display: grid;
}

.device-copy strong {
  overflow: hidden;
  font-size: 17px;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.device-copy small {
  color: var(--muted);
  font-size: 11px;
}

.device-facts {
  margin-top: 20px;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 7px;
}

.device-fact {
  min-width: 0;
  padding: 9px 8px;
  display: grid;
  border-radius: 12px;
  background: rgba(255, 255, 255, .045);
}

.device-fact strong {
  overflow: hidden;
  font-size: 11.5px;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.device-fact small {
  color: var(--muted);
  font-size: 9px;
}

.quick-grid {
  margin-top: 11px;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 9px;
}

.quick-action {
  min-height: 78px;
  padding: 12px;
  display: flex;
  align-items: center;
  gap: 10px;
  overflow: hidden;
  color: var(--text);
  border-radius: var(--radius-md);
  text-align: left;
  transition: transform .22s var(--spring), background .2s;
}

.quick-action > .icon {
  width: 23px;
  height: 23px;
  flex: 0 0 auto;
  color: var(--cyan);
}

.quick-action span {
  min-width: 0;
  display: grid;
}

.quick-action strong {
  font-size: 12.5px;
}

.quick-action small {
  overflow: hidden;
  color: var(--muted);
  font-size: 9.5px;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.search-box {
  min-height: 54px;
  padding: 5px 6px 5px 15px;
  display: flex;
  align-items: center;
  gap: 9px;
  border-radius: 18px;
}

.search-box > .icon {
  width: 20px;
  height: 20px;
  flex: 0 0 auto;
  color: var(--muted);
}

.search-box input {
  width: 100%;
  min-width: 0;
  border: 0;
  background: transparent;
  font-size: 13px;
}

.search-box input::placeholder {
  color: var(--muted);
}

.search-box__submit {
  min-width: 64px;
  min-height: 42px;
  padding: 0 12px;
  color: #fff;
  border-radius: 13px;
  background: linear-gradient(145deg, rgba(var(--violet-rgb), .88), rgba(var(--blue-rgb), .8));
  font-size: 11px;
  font-weight: 750;
}

.memory-health,
.social-pulse,
.trust-summary {
  min-height: 104px;
  margin-top: 11px;
  padding: 16px;
  overflow: hidden;
  border-radius: var(--radius-lg);
}

.health-row,
.social-row,
.trust-row {
  display: flex;
  align-items: center;
  gap: 11px;
}

.health-ring,
.social-sigil,
.trust-sigil {
  width: 45px;
  height: 45px;
  flex: 0 0 auto;
  display: grid;
  place-items: center;
  color: var(--gold);
  border-radius: 15px;
  background: rgba(var(--gold-rgb), .085);
}

.health-copy,
.social-copy,
.trust-copy {
  min-width: 0;
  display: grid;
}

.health-copy strong,
.social-copy strong,
.trust-copy strong {
  font-size: 13px;
}

.health-copy small,
.social-copy small,
.trust-copy small {
  color: var(--muted);
  font-size: 10.5px;
}

.health-metrics {
  margin-top: 13px;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 6px;
}

.health-metrics span {
  min-width: 0;
  padding: 7px;
  display: grid;
  border-radius: 10px;
  background: rgba(255, 255, 255, .04);
  text-align: center;
}

.health-metrics strong {
  overflow: hidden;
  font-size: 12px;
  text-overflow: ellipsis;
}

.health-metrics small {
  color: var(--muted);
  font-size: 8.5px;
  text-transform: uppercase;
}

.map-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 9px;
}

.map-card {
  min-height: 126px;
  padding: 14px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8px;
  color: var(--text);
  border: 1px solid var(--stroke);
  border-radius: var(--radius-lg);
  background:
    radial-gradient(circle at 100% 0, rgba(var(--gold-rgb), .095), transparent 48%),
    var(--surface);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .05);
  text-align: left;
}

.map-card .icon {
  color: var(--gold);
}

.map-card strong {
  margin-top: auto;
  font-size: 13px;
}

.map-card small {
  color: var(--muted);
