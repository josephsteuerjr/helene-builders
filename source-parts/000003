MESSAGE_SCHEMA = "praxis.group.message.v1"
UTC = dt.timezone.utc


@dataclass(frozen=True)
class OutgoingMessage:
    archive: str
    line: int
    timestamp: str
    peer_id: str
    topic_id: int | None
    message_id: int
    reply_to_message_id: int | None
    text: str

