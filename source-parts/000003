class _CountingClient:
    def __init__(self, text="объяснение: это её часы"):
        self.calls = 0
        outer = self

        class _M:
            def create(_s, **kw):
                outer.calls += 1
                outer.last = kw
                return types.SimpleNamespace(
                    stop_reason="end_turn",
                    content=[types.SimpleNamespace(type="text", text=text)])
        self.messages = _M()


