/* ------------------------------------------------------------------ этажи и лифт */
const FLOORS = [
  ["sky", "↑", "Небо"], ["houses", "0", "Дома"], ["people", "−1", "Жители"], ["gates", "−2", "Ворота"],
  ["metro", "−3", "Метро"], ["water", "−4", "Водохранилище"], ["rock", "−5", "Фундамент"], ["keys", "−6", "Ключи"],
