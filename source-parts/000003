        """
        per_proc, procs = 120, 2
        notes.MAX_ENTRIES = 10_000
        child = (
            "import sys, notes\n"
            "notes._acquire = lambda fd, wait: (False, 'none: тест снял замок нарочно')\n"
            "notes.MAX_ENTRIES = 10000\n"
            "chat, tag, count = sys.argv[1], sys.argv[2], int(sys.argv[3])\n"
