    root = (Path(tasks_dir) if tasks_dir else TASKS_DIR) / str(task_id) / "agents"
    out = []
    if root.is_dir():
        for agent_id in sorted(p.name for p in root.iterdir() if p.is_dir()):
            result = _read_json(root / agent_id / "result.json", {})
            if isinstance(result, dict):
