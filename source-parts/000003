# Маркер класса необязателен: `(?:\S+\s+)?`, а не `\S*` — жадная звёздочка на заголовке
# БЕЗ маркера («## rail_x») откусывала бы имя и отдавала хвост («x») за id.
_HEADING_RE = re.compile(r"^##\s+(?:\S+\s+)?([A-Za-z0-9_]+)\s*$", re.M)


def manifest_ids(text: str) -> set[str]:
    """id рельсов из `## `-заголовков манифеста (маркер класса перед id не мешает)."""
    return {m.group(1) for m in _HEADING_RE.finditer(text or "")}


# Строка значения в файле — ровно та, что пишет render_md. Значение едет одной строкой:
# перевода строки внутри значений нет ни у одного рельса, и разбор на это опирается.
_VALUE_LINE_RE = re.compile(r"^- сейчас: (.*)$")


def manifest_values(text: str) -> dict[str, str]:
    """{id рельса: то, что файл называет его СЕГОДНЯШНИМ значением}."""
    out: dict[str, str] = {}
    current = ""
    for line in (text or "").splitlines():
        head = _HEADING_RE.match(line)
        if head:
            current = head.group(1)
            continue
        if not current:
            continue
        value = _VALUE_LINE_RE.match(line)
        if value:
            out.setdefault(current, value.group(1).strip())
    return out


