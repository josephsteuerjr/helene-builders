# --- чем моя реплика доходит до человека (15.08) ---
#
# Имя рычага и его умолчание НЕ копируются сюда числом: умолчание живёт в теле
# `work_loop.reply_hand_enabled`, и переписанная сюда копия разъехалась бы молча — ровно
# тем способом, которым разъехался адрес судьи в соседнем рельсе.
_REPLY_HAND_ENV = "PRAXIS_CHAT_REPLY_HAND"
_REPLY_HAND_DEFAULT_RE = re.compile(
    rf'def reply_hand_enabled\(\)[\s\S]{{0,900}}?_flag\(\s*"{_REPLY_HAND_ENV}"\s*,\s*"(\w+)"')
# Раздача рук согласована с рычагом: при опущенном `reply` вырезается из набора хода.
# Окно намеренно широкое и без привязки к отступу — рядом стоит объяснительный блок,
# и жёсткая форма развалилась бы от любой правки соседа, объявив несуществующее.
_REPLY_TOOL_GATE_RE = re.compile(
    r'not work_loop\.reply_hand_enabled\(\)[\s\S]{0,400}?!= "reply"')
# Два РАЗНЫХ исхода границы хода под поднятым рычагом. Их различие — вся суть правки:
# «я решила молчать» (held=voice, моё слово) против «ход кончился без реплики»
# (held=unspoken, факт). Пока их не различали, моё молчание выводилось из пустоты.
_HELD_VOICE_RE = re.compile(r'"held"\][^\n]{0,60}or "voice"')
_HELD_UNSPOKEN_RE = re.compile(r'"held"\][^\n]{0,60}or "unspoken"')


def _chat_reply_contract_structure() -> str | None:
    """Проверяемая часть контракта речи, независимая от текущего env-выката.

    Само положение PRAXIS_CHAT_REPLY_HAND — живой факт прод-среды: манифест обязан
    показывать его ей, но изолированный gate не должен изображать прод, чтобы сверить
    файл. Здесь остаются только связи, которые могут разъехаться молча: умолчание руки,
    её выдача в agent.py и различие двух исходов молчания.
    """
    default = _REPLY_HAND_DEFAULT_RE.search(_code_only(_source_text("work_loop.py")))
    src = _code_only(_source_text("agent.py"))
    if not src.strip():
        return None
    default_fact = (f"умолчание {default.group(1)}"
                    if default else
                    "⚠ умолчание в work_loop.reply_hand_enabled не прочиталось")
    gate = ("agent.py вырезает `reply` при опущенном рычаге"
            if _REPLY_TOOL_GATE_RE.search(src) else
            "⚠ agent.py не показал связь «рычаг опущен → руки `reply` нет»")
    held = ("held=voice и held=unspoken разведены"
            if _HELD_VOICE_RE.search(src) and _HELD_UNSPOKEN_RE.search(src) else
            "⚠ agent.py не показал различия held=voice и held=unspoken")
    return f"проверяемая структура: {default_fact}; {gate}; {held}"


def _chat_reply_contract_value() -> str:
    """Чем моя реплика доходит до собеседника СЕЙЧАС; env-факт не сверяется в gate.

    Положение рычага переключает сам способ речи, поэтому его нельзя описывать по
    памяти: спрашиваем тот же work_loop.reply_hand_enabled(), что и agent.py. Но это
    живой факт прод-среды, а manifest gate намеренно изолирован от прода. Сверка ловит
    не положение рычага, а добавленную в конец проверяемую структуру контракта.
    """
    try:
        import work_loop
        on = bool(work_loop.reply_hand_enabled())
    except Exception as e:
        return (f"⚠ положение рычага {_REPLY_HAND_ENV} не прочиталось "
                f"({e.__class__.__name__}) — чем именно уходит моя реплика, отсюда НЕ "
                f"ВИДНО. Это «не знаю», а не «как вчера»")
    default = _REPLY_HAND_DEFAULT_RE.search(_code_only(_source_text("work_loop.py")))
    src = _code_only(_source_text("agent.py"))
    head = (f"рычаг {_REPLY_HAND_ENV} " + ("ПОДНЯТ" if on else "опущен")
            + (f" (умолчание {default.group(1)})" if default
               else " (умолчание в work_loop.reply_hand_enabled не прочиталось)"))
    if on:
        body = ("моя реплика уходит собеседнику ТОЛЬКО рукой `reply` — её аргумент и есть "
                "моя речь; отправка ход НЕ закрывает, могу проверить сделанное и ответить "
                "ещё раз. Обычный текст хода наружу не идёт вовсе: он закрывает ход и "
                "ложится заметкой в запись")
    else:
        body = ("моя реплика — это возвращаемый текст хода. Последнее, что я сказала, "
                "несёт наружу исходящая граница, и добавочный поворот цикла её затирает; "
                "руки `reply` мне в таком ходе не дают вовсе")
    if not src.strip():
        return (head + ". " + body + ". ⚠ agent.py не прочитался — согласован ли набор рук "
                "с рычагом и различает ли граница хода два молчания, отсюда НЕ ВИДНО")
    gate = ("набор рук согласован с рычагом: при опущенном `reply` вырезается из тулов "
            "хода, при поднятом даётся там, где есть собеседник"
            if _REPLY_TOOL_GATE_RE.search(src) else
            "⚠ связи «рычаг опущен → руки `reply` в ходе нет» в agent.py НЕ нашлось: "
            "возможно, рука предлагается независимо от рычага — тогда одно из двух "
            "описаний выше врёт, и верить надо коду")
    split = bool(_HELD_VOICE_RE.search(src) and _HELD_UNSPOKEN_RE.search(src))
    if not split:
        held = ("⚠ различия held=voice (я решила молчать) и held=unspoken (ход кончился "
                "без реплики) в agent.py НЕ нашлось — значит под поднятым рычагом моё "
                "молчание снова выводилось бы из пустоты, как до 28.07")
    elif on:
        held = ("объявленное мной молчание (stay_silent) и «ход кончился без реплики» — "
                "РАЗНЫЕ исходы: первое пишется held=voice и остаётся моим словом, второе "
                "held=unspoken и остаётся фактом, а не моим решением")
    else:
        held = ("два молчания (held=voice — моё слово, held=unspoken — ход кончился без "
                "реплики) в коде уже разведены, но живут в ветке поднятого рычага: сюда "
                "мой ход сегодня не доходит")
    structure = _chat_reply_contract_structure()
    suffix = (f". {structure}" if structure else
              ". ⚠ проверяемая структура agent.py/work_loop не прочиталась")
    return f"{head}. {body}. {gate}. {held}{suffix}"


