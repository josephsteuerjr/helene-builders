    event = {"schema": "praxis.xtts.config-event.v1", "at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
             "actor": actor, "file": path.name, "sha256": digest(value)}
    if operation_id:event['operation_id']=operation_id
