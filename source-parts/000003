def _file_image(name: str, sha: str | None = None, seq: int = 1) -> dict:
    block = {"type": "image", "path": f"/app/memory/runs/r/artifacts/{seq:04d}-{name}.model.jpg",
             "mime": "image/jpeg", "detail": "auto", "origin": "file-observe"}
    if sha:
