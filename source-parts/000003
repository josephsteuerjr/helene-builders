                                 _followup_caps(), _followup_letter_face()) if x)


_BROKER = "serverd/broker.py"


def _budget_ceiling(conn: float | None) -> float | None:
    """Потолок её собственного `budget_seconds`. Дефолт объявлен НЕ литералом, а именем
    соседней константы (`CONNECTION_TIMEOUT_SEC`) — подставить сюда своё число значило бы
    развязать их молча: разъедутся при первой же правке соседа."""
    match = re.search(r"WORKSPACE_BUDGET_MAX_SEC = _env_number\(\s*\"[^\"]*\",\s*([\w.]+)",
                      _source_text(_BROKER))
    if not match:
        return None
    raw = match.group(1)
    if raw == "CONNECTION_TIMEOUT_SEC":
        return conn
    try:
        return float(raw)
    except ValueError:
        return None


# ⚠ 27.07. Кап поиска по хосту НЕ равен бюджету обхода и рычага не имеет: обход рвётся на
# SEARCH_FILE_CAP прочитанных файлов, а приписку к оборванному поиску писал чужой кошелёк
# (Budget.note) — он называл ДРУГОЕ число и советовал PRAXIS_FORGE_SCAN_FILES, рычаг, на
# search не влияющий. Владелец brokerops правит это в той же волне, поэтому «объясняет ли
# демон свой кап сам» здесь не утверждается, а ПРОВЕРЯЕТСЯ по его коду: перестанет —
# рельс останется единственным местом, где записана правда, и скажет об этом вслух.
_SEARCH_OWN_NOTE_RE = re.compile(r'f"[^"]*\{SEARCH_FILE_CAP\}')


def _search_caps_note() -> str:
    src = _source_text(_BROKEROPS)
    files = _from_source(_BROKEROPS, r"(?m)^SEARCH_FILE_CAP = (\d+)")
    hits = (_from_source(_BROKEROPS, r"(?m)^SEARCH_HIT_CAP = (\d+)")
            or _from_source(_BROKEROPS, r"if len\(hits\) >= (\d+):"))
    if files is None:
        return "Кап поиска по хосту не прочитался — сколько файлов он успевает, я не знаю."
    note = (f"Поиск (search) рвётся на {files} ПРОЧИТАННЫХ файлах (SEARCH_FILE_CAP) или на "
            f"{_num(hits)} находках, и env-рычага у этих двух нет — они литералы в "
            f"serverd/brokerops.py; PRAXIS_FORGE_SCAN_FILES их не двигает, помогает только "
            f"сужение path/glob.")
    if _SEARCH_OWN_NOTE_RE.search(src):
        return note
    return note + (" ⚠ Сам демон этот кап по имени не называет: приписку к оборванному поиску "
                   "пишет кошелёк ОБХОДА (Budget.note) — там будет чужое число и совет про "
                   "PRAXIS_FORGE_SCAN_FILES. Верное число — здесь.")


def _serverd_workspace_value() -> str:
    """Бюджет счёта на СТОРОНЕ демона. Читается из репозитория, а не спрашивается у демона:
    рельс собирается на пути её ответа, и лишний RPC здесь стоит секунд её же времени.
    Живой демон ставится из этих самых файлов (serverd/install.sh), но если выкатили только
    контейнер — числа разойдутся, и это названо прямо."""
    budget = _from_source(_BROKER, _decl("WORKSPACE_BUDGET_SEC", "_env_number"), float)
    wait = _from_source(_BROKER, _decl("WORKSPACE_WAIT_SEC", "_env_number"), float)
    slots = _from_source(_BROKER, r"min\((\d+), \(os\.cpu_count\(\) or \d+\) - 1\)", int)
    heavy = re.search(r"HEAVY_INSPECT_ACTIONS = \{([^}]*)\}", _source_text(_BROKER))
    actions = (", ".join(x.strip().strip('"\'') for x in heavy.group(1).split(",") if x.strip())
               if heavy else "не прочиталось")
    conn = _from_source(_BROKER, _decl("CONNECTION_TIMEOUT_SEC", "_env_number"), float)
    ceiling = _budget_ceiling(conn)
    return (f"демон считает мой тяжёлый inspect не дольше {_sec(budget)} и отдаёт ЧАСТИЧНЫЙ "
            f"ответ с признаком усечения, а не молчание; одновременно тяжёлых чтений по "
            f"умолчанию min({_sec(slots, '')}, ядра−1) на машине демона, очередь за "
