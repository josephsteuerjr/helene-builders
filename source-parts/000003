        with mock.patch.dict(os.environ, {"PRAXIS_RUNS_RETENTION": "off"}):
            out = runs_prune.prune(self.tmp, now=NOW, apply=True)
        self.assertTrue((run_dir / "results").exists())
        self.assertIn("off", out["errors"][0])

