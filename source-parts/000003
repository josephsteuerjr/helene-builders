}

.system-actions .icon {
  width: 21px;
  height: 21px;
  flex: 0 0 auto;
  color: var(--green);
}

.system-actions span {
  min-width: 0;
  display: grid;
}

.system-actions strong {
  font-size: 11px;
}

.system-actions small {
  overflow: hidden;
  color: var(--muted);
  font-size: 9px;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.dock {
  position: absolute;
  z-index: 32;
  left: max(10px, var(--safe-left));
  right: max(10px, var(--safe-right));
  bottom: max(8px, var(--safe-bottom));
  min-height: var(--dock-height);
  padding: 7px 6px;
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  align-items: stretch;
  gap: 2px;
  overflow: hidden;
  border-radius: 24px;
  background:
    linear-gradient(160deg, rgba(255, 255, 255, .075), transparent 38%),
    rgba(14, 18, 28, .74);
  box-shadow: 0 22px 58px rgba(0, 0, 0, .38), inset 0 1px 0 rgba(255, 255, 255, .09);
}

:root[data-theme="light"] .dock {
  background: rgba(247, 249, 253, .77);
}

.dock__item {
  position: relative;
  min-width: 0;
  min-height: 58px;
  padding: 6px 2px 4px;
  display: grid;
  place-items: center;
  align-content: center;
  gap: 3px;
  color: var(--muted);
  border-radius: 18px;
  background: transparent;
  font-size: 9px;
  font-weight: 650;
  transition: color .2s, background .25s, transform .22s var(--spring);
}

.dock__item .icon {
  width: 21px;
  height: 21px;
}

.dock__item.is-active {
  color: var(--text);
  background: linear-gradient(145deg, rgba(var(--violet-rgb), .17), rgba(var(--blue-rgb), .08));
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .075);
}

.dock__item.is-active .icon {
  color: var(--violet);
  filter: drop-shadow(0 0 8px rgba(var(--violet-rgb), .3));
}

.dock__item:active {
  transform: scale(.91);
}

.nav-badge {
  position: absolute;
  top: 5px;
  left: calc(50% + 7px);
  width: 7px;
  height: 7px;
  border: 1px solid rgba(8, 11, 18, .7);
  border-radius: 50%;
  background: var(--red);
  box-shadow: 0 0 9px rgba(var(--red-rgb), .6);
}

.scrim {
  position: fixed;
  z-index: 60;
  inset: 0;
  background: rgba(2, 4, 8, .55);
  -webkit-backdrop-filter: blur(7px);
  backdrop-filter: blur(7px);
  opacity: 0;
  transition: opacity .25s;
}

.scrim.is-visible {
  opacity: 1;
}

.sheet {
  position: fixed;
  z-index: 61;
  left: max(8px, var(--safe-left));
  right: max(8px, var(--safe-right));
  bottom: max(8px, var(--safe-bottom));
  max-height: min(86dvh, 820px);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border-radius: 29px;
  background:
    linear-gradient(155deg, rgba(255, 255, 255, .095), transparent 33%),
    rgba(18, 23, 35, .91);
  box-shadow: 0 32px 100px rgba(0, 0, 0, .54), inset 0 1px 0 rgba(255, 255, 255, .12);
  transform: translate3d(0, calc(100% + 24px), 0) scale(.98);
  opacity: 0;
  transition: transform .43s var(--ease-out), opacity .25s;
}

:root[data-theme="light"] .sheet {
  background: rgba(246, 249, 254, .94);
}

.sheet.is-visible {
  transform: translate3d(0, 0, 0) scale(1);
  opacity: 1;
}

.sheet__grip {
  width: 39px;
  height: 4px;
  flex: 0 0 auto;
  margin: 9px auto 2px;
  border-radius: 99px;
  background: rgba(255, 255, 255, .2);
}

.sheet__header {
  min-height: 68px;
  padding: 8px 14px 8px 19px;
  display: flex;
  align-items: center;
  gap: 12px;
  border-bottom: 1px solid rgba(255, 255, 255, .07);
}

.sheet__header > div {
  min-width: 0;
  flex: 1;
}

.sheet__header h2 {
  max-width: 100%;
  margin: 2px 0 0;
  overflow: hidden;
  font-size: 19px;
  letter-spacing: -.035em;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.sheet__body {
  min-height: 120px;
  padding: 15px 17px calc(20px + var(--safe-bottom));
  overflow-y: auto;
  overscroll-behavior: contain;
  -webkit-overflow-scrolling: touch;
}

.detail-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
}

.detail-cell {
  min-width: 0;
  padding: 10px;
  display: grid;
  gap: 2px;
  border: 1px solid rgba(255, 255, 255, .06);
  border-radius: 13px;
  background: rgba(255, 255, 255, .035);
}

.detail-cell small {
  color: var(--muted);
  font-size: 9px;
  letter-spacing: .06em;
  text-transform: uppercase;
}

.detail-cell strong {
  overflow-wrap: anywhere;
  font-size: 11.5px;
}

.detail-section {
  margin-top: 18px;
}

.detail-section h3 {
  margin: 0 0 8px;
  font-size: 13px;
}

.detail-copy {
  margin: 0;
  color: var(--text-soft);
  font-size: 12px;
  line-height: 1.58;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.timeline {
  display: grid;
  gap: 0;
}

.timeline-row {
  position: relative;
  min-height: 52px;
  padding: 7px 0 10px 25px;
  display: grid;
}

.timeline-row::before {
  content: "";
  position: absolute;
  left: 6px;
  top: 15px;
  bottom: -7px;
  width: 1px;
  background: rgba(255, 255, 255, .1);
}

.timeline-row:last-child::before { display: none; }

.timeline-row::after {
  content: "";
  position: absolute;
  left: 2.5px;
  top: 13px;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--violet);
  box-shadow: 0 0 10px rgba(var(--violet-rgb), .45);
}

.timeline-row strong {
  font-size: 11.5px;
}

.timeline-row small {
  color: var(--muted);
  font-size: 9.5px;
}

.action-row {
  margin-top: 18px;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.action-button {
  min-height: 44px;
  padding: 0 14px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  color: var(--text);
  border: 1px solid var(--stroke);
  border-radius: 14px;
  background: rgba(255, 255, 255, .06);
  font-size: 11px;
  font-weight: 700;
}

.action-button .icon {
  width: 17px;
  height: 17px;
}

.action-button--primary {
  color: #fff;
  border-color: rgba(var(--violet-rgb), .3);
  background: linear-gradient(145deg, rgba(var(--violet-rgb), .88), rgba(var(--blue-rgb), .76));
  box-shadow: 0 7px 22px rgba(var(--violet-rgb), .2);
}

.action-button--danger {
  color: var(--red);
  border-color: rgba(var(--red-rgb), .2);
  background: rgba(var(--red-rgb), .08);
}

.field {
  margin-top: 12px;
  display: grid;
  gap: 6px;
}

fieldset.field {
  min-width: 0;
  padding: 0;
  border: 0;
}

.field label,
.field > span,
.field > legend {
  color: var(--muted);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .055em;
  text-transform: uppercase;
}

.field input,
.field textarea,
.field select {
  width: 100%;
  min-height: 48px;
  padding: 11px 13px;
  color: var(--text);
  border: 1px solid var(--stroke);
  border-radius: 14px;
  background: rgba(255, 255, 255, .05);
}

.field textarea {
  min-height: 92px;
  resize: vertical;
}

/* ⚠ 03.08.2026. Карты её памяти показываются здесь, а НЕ в .recap-copy ниже: у той
   коробки свой max-height: min(48vh, 520px), и внутри листа, который сам скроллится,
   это давало вложенную прокрутку — 35 КБ RUNS.md в окошке высотой в пол-экрана. У
   .md-doc собственной высоты НЕТ намеренно: скроллер один на лист, .sheet__body.
   ⚠ Вторая ловушка рядом: переменная --mono не объявлена в этом файле НИГДЕ, поэтому
   `font: 11px/1.55 var(--mono)` у .recap-copy невалиден при вычислении и целиком
   отбрасывается — вместе с размером и межстрочником. Здесь свойства заданы поштучно,
   чтобы вид карты не зависел от переменной-призрака. */
.md-doc {
  color: var(--text-soft);
  font-size: 13.5px;
  line-height: 1.62;
  overflow-wrap: anywhere;
  user-select: text;
}

.md-facts,
.md-notice {
  margin: 0 0 10px;
  color: var(--muted);
  font-size: 10.5px;
  overflow-wrap: anywhere;
}

.md-notice {
  padding: 8px 10px;
  color: var(--gold);
  border: 1px solid var(--stroke);
  border-radius: 12px;
  background: rgba(var(--gold-rgb), .08);
}

.md-doc .md-h {
  margin: 18px 0 7px;
  color: var(--text);
  font-size: 14px;
  letter-spacing: -.01em;
}

.md-doc .md-h:first-child {
  margin-top: 0;
}

.md-doc h4.md-h {
  color: var(--text-soft);
  font-size: 12.5px;
}

.md-doc .md-p {
  margin: 0 0 10px;
}

.md-doc .md-quote {
  margin: 0 0 12px;
  padding: 2px 0 2px 12px;
  color: var(--muted);
  border-left: 2px solid var(--stroke);
}

.md-doc .md-list {
  margin: 0 0 12px;
  padding-left: 18px;
}

.md-doc .md-li {
  margin: 0 0 5px;
}

.md-doc .md-li--nested {
  margin-left: 14px;
  color: var(--muted);
}

.md-doc .md-code,
.md-doc .md-pre {
  font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace;
  font-size: 11.5px;
}

.md-doc .md-code {
  padding: 1px 5px;
  border-radius: 6px;
  background: rgba(255, 255, 255, .06);
}

.md-doc .md-pre {
  margin: 0 0 12px;
  padding: 11px 12px;
  overflow-x: auto;
  white-space: pre;
  border: 1px solid var(--stroke);
  border-radius: 12px;
  background: rgba(4, 7, 14, .28);
}

/* Внутренняя цель («../people/владелец.md») — не ссылка: открыть этот файл аппу пока
   нечем, и подчёркнутая ссылка обещала бы переход, которого нет. Адрес стоит рядом
   приглушённым — чтобы владелец видел, ГДЕ это лежит, и мог спросить у неё. */
.md-doc .md-link {
  color: var(--text);
}

.md-doc .md-link__target {
  margin-left: 5px;
  color: var(--muted);
  font-size: 10px;
}

.md-doc .md-link--web {
  color: var(--gold);
  text-decoration: underline;
  text-underline-offset: 2px;
}

.recap-copy {
  max-height: min(48vh, 520px);
  margin: 0;
  padding: 13px 14px;
  overflow: auto;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  color: var(--text-soft);
  border: 1px solid var(--stroke);
  border-radius: 14px;
  background: rgba(4, 7, 14, .28);
  font: 11px/1.55 var(--mono);
  user-select: text;
}

.choice-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 7px;
}

.choice {
  position: relative;
  min-height: 48px;
  padding: 10px 11px;
  display: flex;
  align-items: center;
  gap: 8px;
  border: 1px solid var(--stroke);
  border-radius: 13px;
  background: rgba(255, 255, 255, .035);
  font-size: 10.5px;
}

.choice input {
  width: 16px;
  height: 16px;
  accent-color: var(--violet);
}

.toast-region {
  position: fixed;
  z-index: 90;
  left: max(15px, var(--safe-left));
  right: max(15px, var(--safe-right));
  bottom: calc(var(--dock-height) + var(--safe-bottom) + 22px);
  display: grid;
  justify-items: center;
  gap: 8px;
  pointer-events: none;
}

.toast {
  max-width: min(430px, 96%);
  padding: 11px 15px;
  color: var(--text);
  border: 1px solid var(--stroke-bright);
  border-radius: 14px;
  background: rgba(20, 25, 37, .9);
  box-shadow: 0 16px 42px rgba(0, 0, 0, .38);
  -webkit-backdrop-filter: blur(20px) saturate(150%);
  backdrop-filter: blur(20px) saturate(150%);
  font-size: 11.5px;
  text-align: center;
  opacity: 0;
  transform: translateY(12px) scale(.97);
  animation: toast-in .28s var(--ease-out) forwards;
}

.toast.is-error {
  color: #ffd8df;
  border-color: rgba(var(--red-rgb), .25);
  background: rgba(79, 28, 40, .9);
}

.toast.is-leaving {
  animation: toast-out .22s ease forwards;
}

@keyframes toast-in { to { opacity: 1; transform: translateY(0) scale(1); } }
@keyframes toast-out { to { opacity: 0; transform: translateY(-6px) scale(.98); } }

.boot-state {
  position: fixed;
  z-index: 100;
  inset: 0;
  display: grid;
  place-items: center;
  align-content: center;
  gap: 8px;
  padding: 24px;
  color: var(--text);
  background:
    radial-gradient(circle at 50% 42%, rgba(var(--violet-rgb), .16), transparent 30%),
    rgba(6, 8, 14, .94);
  text-align: center;
  transition: opacity .48s, visibility .48s;
}

:root[data-theme="light"] .boot-state {
  background: rgba(231, 237, 248, .96);
}

.boot-state.is-done {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

.boot-state strong {
  margin-top: 10px;
  font-size: 15px;
}

.boot-state small {
  color: var(--muted);
  font-size: 11px;
}

.boot-state__orb {
  position: relative;
  width: 78px;
  height: 78px;
}

.boot-state__orb i {
  position: absolute;
  inset: 50%;
  border: 1px solid rgba(var(--violet-rgb), .4);
  border-radius: 50%;
  transform: translate(-50%, -50%);
  animation: boot-orbit 2.2s linear infinite;
}

.boot-state__orb i:nth-child(1) { width: 72px; height: 72px; border-right-color: transparent; }
.boot-state__orb i:nth-child(2) { width: 47px; height: 47px; border-color: rgba(var(--cyan-rgb), .45); border-left-color: transparent; animation-direction: reverse; animation-duration: 1.55s; }
.boot-state__orb i:nth-child(3) { width: 13px; height: 13px; border: 0; background: var(--violet); box-shadow: 0 0 26px rgba(var(--violet-rgb), .78); }

@keyframes boot-orbit { to { transform: translate(-50%, -50%) rotate(360deg); } }

.skeleton {
  position: relative;
  overflow: hidden;
  color: transparent !important;
  border-radius: 8px;
  background: rgba(255, 255, 255, .055);
}

.skeleton::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(100deg, transparent 28%, rgba(255, 255, 255, .09) 48%, transparent 68%);
  transform: translateX(-100%);
  animation: skeleton 1.25s linear infinite;
}

@keyframes skeleton { to { transform: translateX(100%); } }

@media (min-width: 680px) {
  .stale-notice {
    left: 50%;
    right: auto;
    width: min(720px, calc(100vw - 48px));
    transform: translateX(-50%);
  }

  .view {
    padding-left: max(24px, calc((100vw - 760px) / 2));
    padding-right: max(24px, calc((100vw - 760px) / 2));
  }

  .dock {
    left: 50%;
    right: auto;
    width: min(620px, calc(100vw - 30px));
    transform: translateX(-50%);
  }

  .hero {
    min-height: 290px;
    padding: 33px 32px 25px;
  }

  .bento {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .bento-card--run { grid-column: span 2; grid-row: span 1; }
  .bento-card--computer { grid-column: span 2; grid-row: span 2; }
  .bento-card--system { grid-column: span 2; }

  .sheet {
    left: 50%;
    right: auto;
    width: min(680px, calc(100vw - 24px));
    transform: translate3d(-50%, calc(100% + 24px), 0) scale(.98);
  }

  .sheet.is-visible {
    transform: translate3d(-50%, 0, 0) scale(1);
  }
}

@media (max-width: 359px) {
  :root { --dock-height: 70px; }
  .view { padding-left: 12px; padding-right: 12px; }
  .topbar { padding-left: 12px; padding-right: 12px; }
  .sync-state { display: none; }
  .hero { padding: 23px 19px 19px; }
  .hero__halo { opacity: .4; }
  .hero__metrics { gap: 13px; }
  .bento { gap: 8px; }
  .bento-card { padding: 12px; }
  .dock { left: 7px; right: 7px; padding-left: 3px; padding-right: 3px; }
  .dock__item span { font-size: 8px; }
}

@media (orientation: landscape) and (max-height: 560px) {
  .topbar { height: calc(56px + var(--safe-top)); padding-top: calc(6px + var(--safe-top)); }
  .view { padding-top: calc(61px + var(--safe-top)); }
  .app-shell.is-stale .view { padding-top: calc(116px + var(--safe-top)); }
  .hero { min-height: 220px; }
  .hero__metrics { margin-top: 15px; }
  .dock { --dock-height: 66px; }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: .001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .001ms !important;
  }

  .aurora__field {
    transform: none !important;
  }

  .tilt {
    transform: none !important;
  }
}

@media (prefers-contrast: more) {
  :root {
    --stroke: rgba(255, 255, 255, .28);
    --text-soft: #d5d9e3;
    --muted: #a8afbd;
  }

  :root[data-theme="light"] {
    --stroke: rgba(17, 22, 34, .32);
    --text-soft: #2f3748;
    --muted: #4f596d;
  }
}

/* ==== PRAXIS REDESIGN: живая краска ==== */
/* Фон стал самостоятельной живописью: краска идёт на полную силу, а прежние
   статичные aurora-поля лишь чуть поддерживают глубину, не мутя поток. */
#ambient { opacity: 1; }
.aurora { opacity: .22; }
@media (prefers-reduced-motion: reduce) {
  /* При отключённой анимации краска — один застывший кадр, аура помогает ему дышать. */
  .aurora { opacity: .6; }
}

/* ═══════════════════════════════════════════════════════════════════
   memory_views.css — «Созвездие» и «Как опыт сворачивается».
   Дописывается В КОНЕЦ app.css. Только новые .mem-* классы,
   существующие компоненты не трогаются.
   ═══════════════════════════════════════════════════════════════════ */

:root {
  --mem-stage-h: 320px;
  --mem-ink: rgba(255, 255, 255, .05);
  --mem-ink-strong: rgba(255, 255, 255, .085);
  --mem-dash: rgba(255, 255, 255, .11);
}

/* Светлая тема сейчас НЕ включается: applyTheme() в app.js жёстко ставит
   data-theme="dark", так что этот блок пока не применяется ни разу.
   Держим его намеренно — светлая тема запланирована, и когда переключатель
   вернётся, «Память» не должна оказаться единственным тёмным пятном. */
:root[data-theme="light"] {
  --mem-ink: rgba(28, 36, 54, .045);
  --mem-ink-strong: rgba(28, 36, 54, .075);
  --mem-dash: rgba(48, 57, 79, .17);
}

.mem-views {
  display: grid;
  gap: 26px;
  margin-top: 22px;
}

.mem-block {
  display: grid;
  gap: 11px;
}

.mem-block__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  margin: 0 2px;
}

/* ⚠ Шапка — flex со space-between. Вторая кнопка, положенная в неё напрямую,
   развела бы заголовок и кнопки по краям и разъехалась бы вёрстка: кнопки
   обязаны жить в одной обойме. */
.mem-block__tools {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 8px;
}

.mem-block__copy {
  min-width: 0;
  display: grid;
  gap: 3px;
}

.mem-block__copy h3 {
  margin: 0;
  font-size: 17px;
  font-weight: 600;
  letter-spacing: -.015em;
}

.mem-block__copy p {
  margin: 0;
  max-width: 46ch;
  color: var(--muted);
  font-size: 11px;
  line-height: 1.42;
}

/* ── общие состояния ─────────────────────────────────────────────── */

.mem-state {
  min-height: 96px;
  padding: 22px 18px;
  display: grid;
  place-items: center;
  align-content: center;
  gap: 5px;
  color: var(--muted);
  border: 1px dashed var(--mem-dash);
  border-radius: var(--radius-lg);
  text-align: center;
}

.mem-state strong {
  color: var(--text-soft);
  font-size: 13px;
  font-weight: 600;
}

.mem-state small {
  max-width: 36ch;
  color: var(--muted);
  font-size: 11px;
  line-height: 1.4;
}

.mem-state--error {
  color: var(--red);
  border-color: rgba(var(--red-rgb), .22);
}

.mem-state--error strong {
  color: var(--red);
}

.mem-state--loading strong {
  opacity: .82;
}

/* ── созвездие ───────────────────────────────────────────────────── */

.mem-stage {
  /* сцена не тянет за собой прокрутку соседей */
  overscroll-behavior: contain;
  position: relative;
  height: var(--mem-stage-h);
  overflow: hidden;
  border: 1px solid var(--stroke);
  border-radius: var(--radius-lg);
  background:
    radial-gradient(circle at 22% 12%, rgba(var(--violet-rgb), .12), transparent 52%),
    radial-gradient(circle at 82% 88%, rgba(var(--cyan-rgb), .1), transparent 55%),
    var(--surface);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .06), var(--shadow-sm);
  -webkit-backdrop-filter: blur(var(--blur)) saturate(160%);
  backdrop-filter: blur(var(--blur)) saturate(160%);
  transform: translateZ(0);
  contain: paint;
}

.mem-canvas {
  display: block;
  width: 100%;
  height: 100%;
  cursor: grab;
  /* ⚠ 03.08.2026, вторая правка за день. Утром здесь `pan-y` заменили на `none`:
     «двигаешь 3D, а едет страница». Переворот оказался хуже, чем описан в его же
     комментарии. JS-гейт в space3d.js и memory_views.js остался прежним и
     по-прежнему БРОСАЛ вертикальную протяжку пальцем, рассчитывая, что её подберёт
     страница. Подбирать стало некому — и вертикальный свайп по сцене перестал
     делать вообще что-либо: ни прокрутки раздела, ни наклона камеры.

     Размен снят целиком, а не отыгран назад. Свёрнутая сцена — полоса в 286–420 px
     внутри прокручиваемой ленты, вертикаль там принадлежит странице. Все жесты
     сцена забирает только развёрнутой (.stage-full ниже): там она занимает экран
     целиком, и отбирать больше не у кого. Развернуть — кнопка «Развернуть» в шапке
     блока или короткий тап по пустому месту холста. */
  touch-action: pan-y;
  outline: none;
}

.mem-canvas:active {
  cursor: grabbing;
}

.mem-canvas:focus-visible {
  outline: 2px solid var(--cyan);
  outline-offset: -3px;
}

.mem-stage__status {
  position: absolute;
  inset: 12px;
  display: grid;
  place-items: center;
  border: 0;
  border-radius: var(--radius-md);
  background: transparent;
  pointer-events: none;
}

.mem-stage__status .mem-state {
  width: min(100%, 320px);
  border-style: solid;
  border-color: var(--stroke);
  background: var(--surface-strong);
  -webkit-backdrop-filter: blur(12px);
  backdrop-filter: blur(12px);
}

.mem-legend {
  position: absolute;
  left: 12px;
  bottom: 11px;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 5px 11px;
  pointer-events: none;
}

.mem-legend__item {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  color: var(--text-soft);
  font-size: 10px;
  letter-spacing: .01em;
}

.mem-legend__dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
}

.mem-legend__item--people .mem-legend__dot {
  background: var(--violet);
  box-shadow: 0 0 9px rgba(var(--violet-rgb), .7);
}

.mem-legend__item--topic .mem-legend__dot {
  background: var(--cyan);
  box-shadow: 0 0 9px rgba(var(--cyan-rgb), .7);
}

.mem-legend__meta {
  color: var(--muted);
  font-size: 10px;
  font-variant-numeric: tabular-nums;
}

/* ── чипы (чаты / «в центр») ─────────────────────────────────────── */

.mem-chips {
  display: flex;
  gap: 7px;
  overflow-x: auto;
  padding-bottom: 3px;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
}

.mem-chips::-webkit-scrollbar {
  display: none;
}

.mem-chip {
  min-height: 44px;
  flex: 0 0 auto;
  padding: 6px 13px;
  display: grid;
  gap: 1px;
  color: var(--text-soft);
  border: 1px solid var(--stroke);
  border-radius: var(--radius-sm);
  background: var(--mem-ink);
  text-align: left;
  transition: border-color .2s var(--ease-out), background .2s var(--ease-out), color .2s var(--ease-out);
}

.mem-chip strong {
  max-width: 22ch;
  overflow: hidden;
  font-size: 12px;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mem-chip small {
  color: var(--muted);
  font-size: 9.5px;
  font-variant-numeric: tabular-nums;
}

.mem-chip:hover {
  background: var(--mem-ink-strong);
}

.mem-chip.is-active {
  color: var(--text);
  border-color: rgba(var(--violet-rgb), .45);
  background: rgba(var(--violet-rgb), .12);
}

.mem-chip.is-active small {
  color: var(--text-soft);
}

/* в чате есть свёртки, которые не разобрались — их прячут только по недосмотру */
.mem-chip.has-unreadable {
  border-color: rgba(var(--red-rgb), .34);
}

.mem-chip.has-unreadable small {
  color: var(--red);
}

.mem-chip--ghost {
  min-height: 34px;
  align-self: center;
  padding: 0 12px;
  display: inline-flex;
  align-items: center;
  color: var(--cyan);
  border-color: var(--stroke);
  background: transparent;
  font-size: 11.5px;
  font-weight: 600;
}

.mem-chip--ghost:hover {
  background: var(--mem-ink);
}

/* ── полноэкранная сцена ─────────────────────────────────────────────
   ⚠ 03.08.2026. Блок стоит ЗДЕСЬ, а не рядом с .mem-stage, и это не вкусовщина:
   `.stage-full__exit` носит и класс `.mem-chip--ghost` (min-height: 34px,
   background: transparent). При равной специфичности выигрывает то, что ниже, —
   выше по файлу наши 44px и подложка были бы молча перебиты.

   Сам слой нельзя было сделать классом на .mem-stage: секция `.view` держит
   `transform` и `will-change: transform`, а трансформированный предок становится
   containing block даже для `position: fixed` — сцена легла бы внутрь секции и
   была бы обрезана её overflow. Поэтому .mem-stage физически переезжает в
   #stageFullscreen (внутри #app, вне `.view`), а в ленте остаётся распорка. */
.stage-full {
  position: fixed;
  inset: 0;
  /* выше топбара (30) и дока (32), ниже scrim (60) и шторки (61): слой перекрывает
     навигацию — значит выход из него только «Свернуть», Escape и BackButton, —
     но досье узла обязано открываться НАД ним */
  z-index: 50;
  display: flex;
  padding: var(--safe-top) var(--safe-right) var(--safe-bottom) var(--safe-left);
  background:
    radial-gradient(circle at 22% 10%, rgba(var(--violet-rgb), .1), transparent 55%),
    var(--bg-deep);
}

/* display: flex перебивает атрибут hidden — без этой строки слой висел бы всегда */
.stage-full[hidden] {
  display: none;
}

.stage-full .mem-stage {
  flex: 1 1 auto;
  min-width: 0;
  width: 100%;
  height: 100%;
  border: 0;
  border-radius: 0;
}

/* развёрнутой сцене вертикаль отдавать некому — все жесты её */
.stage-full .mem-canvas {
  touch-action: none;
}

.stage-full__exit {
  position: absolute;
  z-index: 2;
  top: calc(var(--safe-top) + 12px);
  right: calc(var(--safe-right) + 12px);
  min-height: 44px;                 /* палец, а не курсор: 34px у ghost-чипа мало */
  color: var(--text);
  background: var(--surface-strong);
  -webkit-backdrop-filter: blur(12px);
  backdrop-filter: blur(12px);
}

/* Распорка на месте уехавшей сцены. Без неё лента схлопывается на высоту сцены,
   прокрутка уезжает — и после сворачивания владелец оказывается не там, где был. */
.mem-stage-slot {
  height: var(--mem-stage-h);
  border: 1px dashed var(--mem-dash);
  border-radius: var(--radius-lg);
}

/* ── дендрограмма ────────────────────────────────────────────────── */

.mem-dag {
  display: grid;
  gap: 11px;
}

.mem-dag__summary {
  display: grid;
  /* auto-fit: четвёртая плитка («не прочиталось») появляется только при сбое
     разбора и не должна ломать сетку из трёх */
  grid-template-columns: repeat(auto-fit, minmax(92px, 1fr));
  gap: 7px;
}

.mem-dag__note {
  margin: -2px 2px 0;
  color: var(--muted);
  font-size: 10.5px;
  line-height: 1.4;
  font-variant-numeric: tabular-nums;
}

.mem-scroll {
  overflow-x: auto;
  overflow-y: hidden;
  padding: 4px 0 8px;
  border: 1px solid var(--stroke);
  border-radius: var(--radius-lg);
  background:
    linear-gradient(180deg, transparent 0%, rgba(var(--violet-rgb), .05) 100%),
    var(--surface);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .05);
  -webkit-overflow-scrolling: touch;
  overscroll-behavior-x: contain;
  scrollbar-width: thin;
}

.mem-scroll > .mem-state {
  margin: 10px;
  border-width: 1px;
}

.mem-dendro {
  display: block;
  min-width: 100%;
  height: auto;
}

.mem-dendro__rule {
  stroke: var(--mem-dash);
  stroke-width: 1;
  stroke-dasharray: 2 7;
  opacity: .55;
}

.mem-dendro__stratum {
  fill: var(--muted);
  font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace;
  font-size: 9px;
  letter-spacing: .05em;
  text-transform: uppercase;
}

.mem-dendro__edge {
  fill: none;
  stroke: rgba(var(--blue-rgb), .34);
  stroke-width: 1.1;
  stroke-linecap: round;
}

.mem-dendro__edge.is-frontier {
  stroke: rgba(var(--gold-rgb), .62);
  stroke-width: 1.5;
}

.mem-dendro__edge--episode {
  stroke: rgba(var(--cyan-rgb), .3);
  stroke-width: .9;
  stroke-dasharray: 2 4;
}

.mem-compact {
  cursor: pointer;
  outline: none;
}

.mem-compact__box {
  fill: rgba(var(--violet-rgb), .16);
  stroke: rgba(var(--violet-rgb), .42);
  stroke-width: 1;
  transition: fill .18s var(--ease-out), stroke .18s var(--ease-out);
}

.mem-compact__count {
  fill: var(--text-soft);
  font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace;
  font-size: 9.5px;
  text-anchor: middle;
  pointer-events: none;
}

.mem-compact:hover .mem-compact__box,
.mem-compact:focus-visible .mem-compact__box {
  fill: rgba(var(--violet-rgb), .3);
  stroke: rgba(var(--violet-rgb), .75);
}

.mem-compact:focus-visible .mem-compact__box {
  stroke: var(--cyan);
  stroke-width: 2;
}

.mem-compact.is-frontier .mem-compact__box {
  fill: rgba(var(--gold-rgb), .2);
  stroke: rgba(var(--gold-rgb), .8);
  stroke-width: 1.6;
}

.mem-compact.is-frontier .mem-compact__count {
  fill: var(--gold);
}

.mem-compact.is-legacy .mem-compact__box {
  stroke-dasharray: 3 3;
  opacity: .82;
}

.mem-compact.is-degraded .mem-compact__box {
  stroke: rgba(var(--red-rgb), .62);
}

.mem-compact__flag {
  fill: var(--red);
}

.mem-episode {
  cursor: pointer;
  outline: none;
}

.mem-episode__hit {
  fill: transparent;
}

.mem-episode__dot {
  fill: rgba(var(--cyan-rgb), .55);
  stroke: rgba(var(--cyan-rgb), .85);
  stroke-width: .8;
  transition: fill .18s var(--ease-out);
}

/* «продолжается» — единственный живой статус эпизода, который пишет memory_life
   (вокабуляр: closed / continued; «open» не существует). */
.mem-episode.is-continued .mem-episode__dot {
  fill: var(--cyan);
}

.mem-episode__more {
  fill: var(--muted);
  font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace;
  font-size: 9px;
  text-anchor: middle;
  font-variant-numeric: tabular-nums;
}

.mem-episode:hover .mem-episode__dot,
.mem-episode:focus-visible .mem-episode__dot {
  fill: var(--cyan);
  stroke: var(--text);
}

.mem-events__bar {
  fill: rgba(var(--green-rgb), .2);
  stroke: rgba(var(--green-rgb), .42);
  stroke-width: 1;
}

.mem-events__label {
  fill: var(--muted);
  font-size: 9.5px;
  text-anchor: middle;
  font-variant-numeric: tabular-nums;
}

/* ── досье в шторке ──────────────────────────────────────────────── */

.mem-dossier {
  display: grid;
  gap: 13px;
}

.mem-dossier__title {
  margin: 4px 0 0;
  color: var(--text-soft);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: .07em;
  text-transform: uppercase;
}

.mem-facts {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(88px, 1fr));
  gap: 7px;
}

.mem-fact {
  min-width: 0;
  padding: 9px 10px;
  display: grid;
  gap: 2px;
  border: 1px solid var(--stroke);
  border-radius: 13px;
  background: var(--mem-ink);
}

.mem-fact small {
  color: var(--muted);
  font-size: 9px;
  letter-spacing: .06em;
  text-transform: uppercase;
}

.mem-fact strong {
  overflow-wrap: anywhere;
  font-size: 12px;
  font-variant-numeric: tabular-nums;
}

.mem-flags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.mem-flag {
  padding: 3px 9px;
  color: var(--text-soft);
  border: 1px solid var(--stroke);
  border-radius: 999px;
  background: var(--mem-ink);
  font-size: 10px;
  letter-spacing: .02em;
}

.mem-flag--frontier {
  color: var(--gold);
  border-color: rgba(var(--gold-rgb), .4);
  background: rgba(var(--gold-rgb), .1);
}

.mem-flag--warn {
  color: var(--red);
  border-color: rgba(var(--red-rgb), .38);
  background: rgba(var(--red-rgb), .09);
}

.mem-summary {
  margin: 0;
  padding: 13px 14px;
  color: var(--text-soft);
  border: 1px solid var(--stroke);
  border-radius: var(--radius-md);
  background: var(--mem-ink);
  font-size: 12.5px;
  line-height: 1.52;
  overflow-wrap: anywhere;
}

.mem-meta {
  display: grid;
  gap: 3px;
}

.mem-meta small {
  color: var(--muted);
  font-size: 10px;
  overflow-wrap: anywhere;
}

.mem-mono {
  font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace;
  font-size: 9.5px;
  letter-spacing: -.01em;
}

.mem-neighbours {
  display: grid;
  gap: 6px;
  max-height: 52vh;
  overflow-y: auto;
  overscroll-behavior: contain;
}

.mem-neighbour {
  min-height: 46px;
  padding: 8px 11px;
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--text);
  border: 1px solid var(--stroke);
  border-radius: var(--radius-sm);
  background: var(--mem-ink);
  text-align: left;
  transition: background .18s var(--ease-out), border-color .18s var(--ease-out);
}

.mem-neighbour:hover {
  background: var(--mem-ink-strong);
  border-color: var(--stroke-bright);
}

.mem-neighbour__dot {
  width: 8px;
  height: 8px;
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--cyan);
  box-shadow: 0 0 10px rgba(var(--cyan-rgb), .6);
}

.mem-neighbour--people .mem-neighbour__dot {
  background: var(--violet);
  box-shadow: 0 0 10px rgba(var(--violet-rgb), .6);
}

.mem-neighbour__body {
  min-width: 0;
  flex: 1 1 auto;
  display: grid;
  gap: 1px;
}

.mem-neighbour__body strong {
  overflow: hidden;
  font-size: 12.5px;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mem-neighbour__body small {
  overflow: hidden;
  color: var(--muted);
  font-size: 10px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mem-neighbour__deg {
  flex: 0 0 auto;
  color: var(--muted);
  font-size: 10.5px;
  font-variant-numeric: tabular-nums;
}

/* ── адаптив и доступность ───────────────────────────────────────── */

@media (min-width: 620px) {
  :root {
    --mem-stage-h: 420px;
  }

  .mem-block__copy p {
    font-size: 12px;
  }
}

@media (max-width: 380px) {
  :root {
    --mem-stage-h: 286px;
  }

  .mem-dag__summary {
    grid-template-columns: repeat(auto-fit, minmax(78px, 1fr));
    gap: 5px;
  }
}

@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .mem-stage {
    background: var(--surface-strong);
  }
}

@media (prefers-contrast: more) {
  .mem-dendro__edge {
    stroke: rgba(var(--blue-rgb), .6);
  }

  .mem-compact__box {
    stroke-width: 1.5;
  }

  .mem-state {
    border-style: solid;
  }
}

@media (prefers-reduced-motion: reduce) {
  .mem-chip,
  .mem-neighbour,
  .mem-compact__box,
  .mem-episode__dot {
    transition: none !important;
  }
}

/* ── пространство: подписи поверх холста ─────────────────────────── */

/* Текст в WebGL не рисуется намеренно: Space3D отдаёт экранные координаты
   десятка самых весомых узлов, а подписи остаются обычным DOM — чёткими на
   любом DPR, темизуемыми и доступными для увеличения шрифта системой. */
.mem-labels {
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
  contain: strict;
}

.mem-label {
  position: absolute;
  top: 0;
  left: 0;
  max-width: 15ch;
  overflow: hidden;
  color: var(--text-soft);
  font-size: 10.5px;
  font-weight: 600;
  letter-spacing: -.005em;
  line-height: 1;
  white-space: nowrap;
  text-overflow: ellipsis;
  text-shadow: 0 1px 3px rgba(0, 0, 0, .55);
  opacity: var(--mem-label-a, 1);
  transform: translate3d(var(--mem-label-x, 0), var(--mem-label-y, 0), 0) translateX(-50%);
  will-change: transform;
}

:root[data-theme="light"] .mem-label {
  text-shadow: 0 1px 2px rgba(255, 255, 255, .8);
}

.mem-label.is-selected {
  color: var(--gold);
  text-shadow: 0 0 12px rgba(var(--gold-rgb), .5);
}

/* ── тон по виду узла: один атрибут на легенду, подпись и соседа ──── */

[data-tone="violet"] { --mem-tone: var(--violet-rgb); }
[data-tone="cyan"]   { --mem-tone: var(--cyan-rgb); }
[data-tone="blue"]   { --mem-tone: var(--blue-rgb); }
[data-tone="gold"]   { --mem-tone: var(--gold-rgb); }
[data-tone="green"]  { --mem-tone: var(--green-rgb); }

.mem-legend__item[data-tone] .mem-legend__dot,
.mem-neighbour[data-tone] .mem-neighbour__dot {
  background: rgb(var(--mem-tone, var(--cyan-rgb)));
  box-shadow: 0 0 9px rgba(var(--mem-tone, var(--cyan-rgb)), .7);
}

/* Сцена 3D живёт глубже плоской: фон уходит в темень, чтобы туман к нему
   и сходился (тот же цвет зашит в шейдер как u_fogColor). */
.mem-stage--space {
  background:
    radial-gradient(circle at 26% 8%, rgba(var(--violet-rgb), .16), transparent 54%),
    radial-gradient(circle at 84% 92%, rgba(var(--cyan-rgb), .12), transparent 56%),
    linear-gradient(180deg, rgba(var(--blue-rgb), .05), transparent 60%),
    var(--surface);
}

@media (min-width: 620px) {
  .mem-label { font-size: 11.5px; max-width: 18ch; }
}

@media (prefers-reduced-motion: reduce) {
  .mem-label { will-change: auto; }
}

/* ==== PRAXIS REDESIGN v2: ликвид-гласс без подкраски + тонкая типографика ==== */

/* Стекло перестаёт быть крашеной панелью. Собственного тона у него больше нет:
   цвет приходит ТОЛЬКО от краски, которая течёт за ним. Читаемость держится не
   заливкой, а самой линзой — сильным размытием, подъёмом насыщенности и лёгким
   притемнением подложки (brightness < 1), поэтому белый текст остаётся читаемым
   даже когда под стекло заходит яркий всплеск. */
:root {
  --surface: rgba(255, 255, 255, .045);
  --surface-strong: rgba(255, 255, 255, .085);
  --surface-soft: rgba(255, 255, 255, .035);
  --surface-hover: rgba(255, 255, 255, .10);
  --stroke: rgba(255, 255, 255, .14);
  --stroke-bright: rgba(255, 255, 255, .46);
  --blur: 36px;
  --shadow-lg: 0 30px 80px rgba(0, 0, 0, .28);
  --shadow-sm: 0 14px 40px rgba(0, 0, 0, .16);
}

.glass {
  /* было: тёмно-синяя заливка + градиент поверх — отсюда ощущение крашеного пластика */
  background: var(--surface);
  border: .5px solid var(--stroke);
  box-shadow:
    inset 0 .5px 0 rgba(255, 255, 255, .40),
    inset 0 -.5px 0 rgba(255, 255, 255, .10),
    var(--shadow-sm);
  -webkit-backdrop-filter: blur(var(--blur)) saturate(180%) brightness(.92);
