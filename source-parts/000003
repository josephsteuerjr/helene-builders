                             messages=[{"role": "user", "content": "x"}],
                             tools=tools, max_tokens=1000,
                             thinking=4096 if everything else 0)
        except _Stop:
            pass
    fields = {k for k in seen if k != "extra_body"}
    fields |= set((seen.get("extra_body") or {}))
    return fields


