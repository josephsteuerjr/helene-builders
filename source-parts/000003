  gap: 8px;
}

.draft-note {
  margin: 11px 0 0;
  padding: 10px 12px;
  color: var(--gold);
  border: 1px solid rgba(var(--gold-rgb), .17);
  border-radius: 13px;
  background: rgba(var(--gold-rgb), .065);
  font-size: 10px;
  line-height: 1.45;
}

.system-actions {
  margin-top: 12px;
  padding: 7px;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
