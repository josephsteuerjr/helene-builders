# Имя рычага здесь НЕ вписано руками, и это не педантизм: пока писалась эта запись, владелец
# forge_verify.py переименовал порог (PRAXIS_VERIFY_HOST_DEADLINE_SEC → PRAXIS_VERIFY_TIMEOUT_SEC)
# и сменил значение втрое — ровно то, что случилось с PRAXIS_FORGE_LOCK_ABANDONED_SEC, только
# на моих глазах. Поэтому и константа, и её env читаются одной регуляркой из объявления.
_VERIFY_DEADLINE_RE = re.compile(
    r"(\w*DEADLINE_SEC) = int\(float\(os\.getenv\(\"([A-Z_]+)\"\)\s*or\s*(\d+)\)\)")


# Предел, который связывает, живёт литералом в СИГНАТУРЕ тула, а не в константе модуля.
# Такой не ловится ни поиском по PRAXIS_*, ни описью верхнего уровня — verification_deadline
# нашёлся случайно. У поднятого модуля спрашиваем живую сигнатуру (её можно подменить, и
# рельс обязан поехать за подменой), иначе читаем объявление.
def _tool_signature_default(module: str, func: str, param: str, rel: str) -> int | None:
    live = _live(module, func)
    if live is not None:
        try:
            import inspect as _inspect
            value = _inspect.signature(live).parameters[param].default
            if isinstance(value, (int, float)) and not isinstance(value, bool):
                return int(value)
        except Exception:
            pass
    return _from_source(rel, rf"def {re.escape(func)}\([^)]*?{re.escape(param)}: int = (\d+)")


# Живёт ли env-порог только на `or`, то есть достаётся ли он лишь при явном timeout=0.
_VERIFY_ENV_ON_ZERO_RE = re.compile(r'request\.get\("timeout"\)\s*or\s*\w*DEADLINE_SEC')


def _verification_deadline_value() -> str:
    src = _source_text("forge_verify.py")
    match = _VERIFY_DEADLINE_RE.search(src)
    tool = _tool_signature_default("agent", "tool_coding_verify", "timeout", "agent.py")
    if not match:
        return ("⚠ срок матрицы проверок в forge_verify.py не прочитался — значит я не знаю, "
                "сколько живёт проверка без своего срока")
    name, env, sec = match.group(1), match.group(2), int(match.group(3))
    tail = ("; срок уезжает ОБЕИМ сторонам, чтобы демон останавливал команду сам, а не догорал "
            "после смерти клиента. Он законно длиннее потолка руки: матрица живёт в отдельном "
            "процессе, потолок хода до неё не достаёт")
    if not _VERIFY_ENV_ON_ZERO_RE.search(src):
        # Сосед переписал разбор: env снова может оказаться действующим источником.
        return (f"проверка, пришедшая без своего срока, получает {sec}с ({name}, рычаг {env}); "
                f"дефолт моей руки coding_verify(timeout={_num(tool)})" + tail)
    if tool is None:
        return (f"⚠ дефолт coding_verify(timeout=…) не прочитался, а связывает именно он: "
                f"{name}={sec}с (рычаг {env}) в живом пути НЕ действует — forge.verify всегда "
                f"кладёт число в запрос, и env достаётся только при timeout=0" + tail)
    return (f"проверке без своего срока даётся {tool}с — и это ДЕФОЛТ СИГНАТУРЫ моей руки "
            f"coding_verify(timeout={tool}), а не переменная окружения: forge.verify кладёт это "
            f"число в запрос всегда. {name}={sec}с (рычаг {env}) стоит за `or` и достаётся "
            f"ТОЛЬКО когда я сама зову coding_verify(timeout=0) — в обычном ходе {env} не "
            f"действует, и поставить его в .deploy.env значит ничего не изменить. Настоящий "
            f"рычаг на каждый вызов — мой собственный аргумент timeout" + tail)


