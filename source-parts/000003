            line = line.split("#", 1)[0].strip()
            if line:
                req = Requirement(line)
                requirements[req.name.lower()] = req.specifier
        for name, old, floor, future in (
            ("brotli", "1.2.0", "1.2.1", "1.3.0"),
            ("certifi", "2026.10.18", "2026.10.19", "2027.1.1"),
        ):
