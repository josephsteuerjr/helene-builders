    def test_missing_is_not_zero(self):
        self.write([self.completed(), self.completed(usage={'in': 0, 'out': 0,
                    'cache_read': 0}, duration_ms=0, stop_reason='end_turn')])
        summary = fs.summarize(self.rows())
