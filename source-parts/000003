def _slot(key: str, *, create: bool = False) -> dict | None:
    if not key:
        return None
    with _LOCK:
        slot = _STATE.get(key)
        if slot is None:
            if not create:
                return None
            slot = {"used": 0, "control": None, "touched": time.time()}
            _STATE[key] = slot
            _evict_locked()
