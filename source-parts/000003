MAX_REQUEST_TIMEOUT_SECONDS = 120.0

DEFAULT_CORPUS = (
    "Праксис проверяет сложные имена: Морган, Хоуп, Розенфельд и Ксения; "
    "числа 48 килогерц, 22 августа 2026 года, паузы — и ударения.",
