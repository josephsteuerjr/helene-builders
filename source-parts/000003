        self.soul = self.base / "soul"
        self.soul.mkdir(parents=True)
        (self.soul / "SOUL.md").write_text("# Soul\n\ntruth\n", encoding="utf-8")
        (self.soul / "VOICE.md").write_text("# Voice\n\nplain\n", encoding="utf-8")
