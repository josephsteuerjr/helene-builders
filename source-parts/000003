        with tempfile.TemporaryDirectory() as temporary:
            root = Path(temporary)
            path = root / "objects/run-old.tar"
            path.parent.mkdir()
            path.write_bytes(b"x")
            locator = rr.ArchiveLocator.from_dict(good)
            with self.assertRaisesRegex(rr.ContractError, "mismatch"):
                locator.verify(root)


