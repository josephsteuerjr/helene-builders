    except OSError:
        return
    if len(lines) <= DENIALS_KEEP * 2:
        return
    tail = [l for l in lines if l.strip()][-DENIALS_KEEP:]
    tmp = DENIALS_PATH.with_suffix(".jsonl.tmp")
    tmp.write_text("\n".join(tail) + "\n", encoding="utf-8")
    tmp.replace(DENIALS_PATH)


def recent_denials(n: int = 10) -> list[dict]:
    try:
        lines = DENIALS_PATH.read_text(encoding="utf-8").splitlines()
    except OSError:
        return []
    out: list[dict] = []
    for l in lines[-int(n):]:
        try:
            out.append(json.loads(l))
        except Exception:
            continue
    return out


def denials_today() -> int:
    today = praxis_time.day_key()
    # ⚠ `fromtimestamp` без пояса отдаёт день КОНТЕЙНЕРА. Момент абсолютен и верен —
    # неверным было превращение его в дату: отказ, случившийся в 02:00 по её времени,
    # считался вчерашним. Читаем момент как UTC и переводим в ЕЁ день.
    return sum(1 for r in recent_denials(DENIALS_KEEP)
               if praxis_time.day_key(
                   _dt.datetime.fromtimestamp(r.get("ts", 0), _dt.timezone.utc)) == today)


