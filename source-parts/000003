    have = [n for n in ("matplotlib", "cairosvg", "PIL")
            if importlib.util.find_spec(n) is not None]
    missing = [n for n in ("matplotlib", "cairosvg", "PIL") if n not in have]
    # Переменной окружения здесь нет НАМЕРЕННО, даже как запасного источника пути:
    # продуктовый код её всё равно не читает, а всякое имя, произнесённое манифестом,
    # она вправе принять за рычаг. Ищем браузер там, где он лежит, и говорим фактический путь.
    chromium = next((c for c in ("/usr/bin/chromium", "/usr/bin/chromium-browser")
                     if os.path.exists(c)), "")
    browser = bool(chromium)
    chromium = chromium or "не нашёлся"
    if not have and not browser:
        return ("рук для картинки нет: ни matplotlib/cairosvg/PIL, ни браузера — "
                "нарисовать я сейчас ничего не могу")
    parts = [f"библиотеки: {', '.join(have) if have else 'ни одной'}"]
    if missing:
        parts.append(f"НЕТ: {', '.join(missing)}")
    parts.append(f"браузер для снимка страницы: {chromium} — "
                 + ("на месте" if browser else "ОТСУТСТВУЕТ"))
    return ("; ".join(parts)
            + ". Отдельного тула нет и не нужно: пишу скрипт своим shell и отправляю send_file")


def _scratch_note_lock_value() -> str:
    """Числа записки — из живого notes.py, а не копией сюда. Плюс фактический вид замка:
    ответ «flock» или «его нет» она получает от той же машины, что пишет строку."""
    nums, source = _note_nums()
    wait, entries = nums["_LOCK_WAIT_SEC"], nums["MAX_ENTRIES"]
    factor, probe = nums["_UNLOCKED_TRIM_FACTOR"], nums["_PROBE_WAIT_SEC"]
    short, degrade = nums["_LOCK_WAIT_DEGRADED_SEC"], nums["_LOCK_DEGRADE_FOR_SEC"]
    if wait is None or factor is None or entries is None:
        return ("⚠ пределы записки не прочитались — значит я не знаю, при каких условиях "
                "моя же строка может не схлопнуться")
    kind = ""
    try:
        import notes as _notes  # noqa: PLC0415 — только для честного «что вышло на самом деле»
        kind = str(_notes.lock_kind())
    except Exception:
        kind = ""
    got = f"сейчас замок: {kind}" if kind else "какой замок вышел на этом томе — не спросилось"
    # Короткий режим — не второе ожидание, а ЗАМЕНА первого на полминуты. Молча он бы
    # означал, что «жду до 5с» иногда неправда, а почему — выяснить неоткуда.
    degraded = (f"после первого же ИСТЕЧЕНИЯ этот процесс на {_sec(degrade)} переходит на "
                f"короткое ожидание {_sec(short)} (одна попытка без сна) — записок у меня "
                f"больше сотни, и полное ожидание на каждой стоило бы минут внутри одного "
                f"такта; первый удавшийся захват снимает режим сразу"
                if short is not None and degrade is not None else
                "⚠ короткий режим ожидания в notes.py не прочитался")
    # ⚠ Потолок аварийной обрезки нарочно живёт в СТРОКАХ, хотя окно записки — в
    # ЗАПИСЯХ (03.08.2026, см. notes.MAX_ENTRIES). Это не рассогласование: потолок
    # про РАЗМЕР ФАЙЛА, а окно — про читаемость, и мерить их одной единицей значило бы
    # снова спутать то, что уже путали. Произведение остаётся тем же числом, но теперь
    # оно названо своими сомножителями вслух.
    return (f"жду межпроцессный замок до {_sec(wait)}; не дождалась — строка всё равно "
            f"дописывается, но файл не схлопывается, пока не вырастет выше "
            f"{int(entries * factor)} строк (это {int(entries)}×{int(factor)}: моё окно "
            f"в записях на множитель; сам потолок — в строках, он про размер файла); "
            f"{degraded}; диагностика lock_kind() ждёт своё — {_sec(probe)}, она стоит на "
            f"пути сборки моего блока состояния и не имеет права его тормозить; "
            f"{got} [{source}]")


def _host_text_clip_value() -> str:
    import context_policy
    policy = context_policy.read()
    src = _source_text("agent.py")
    cap = _live("agent", "HOST_TEXT_CAP")
    source = "живая константа"
    if not isinstance(cap, (int, float)) or isinstance(cap, bool):
        # Bound the search to this function: a later unrelated `return 12`
        # must never be reported as the host budget.
        body = re.search(r'(?ms)^def _host_text_cap\([^\n]*\n(.*?)(?=^\S|\Z)', src)
        region = body.group(1) if body else ''
        declared = re.search(r'\breturn\s+(\d+)\b', region)
        cap = (policy['host_text_chars'] if 'context_policy.read()' in region
               else int(declared.group(1)) if declared else None)
        source = "объявление в agent.py — agent в этом процессе не поднят"
    if cap is None:
        return ("⚠ мой кап вывода хоста не прочитался — значит я не знаю, сколько из ответа "
                "демона до меня доезжает")
    cap = int(cap)
    where = _clip_host_call_sites(src)
    places = ("режу в: " + ", ".join(where)) if where else (
        "⚠ ни одного места, где он режет, в agent.py не нашлось — кап объявлен и не применяется")
    if cap <= 0:
        return (f"мой рез снят (0 в PRAXIS_HOST_TEXT_CAP): вывод доходит настолько целым, "
                f"насколько его отдал демон; {places} [{source}]")
    body = _CLIP_BODY_RE.search(src)
    region = body.group(0) if body else ""
    div = _from_source("agent.py", r"tail = min\(cap // (\d+), \d+\)")
    tail_cap = _from_source("agent.py", r"tail = min\(cap // \d+, (\d+)\)")
    if div and tail_cap:
        tail = min(cap // div, tail_cap)
        shape = f"хвост {tail} симв., голова {cap - tail}"
    else:
        shape = "как делится на голову и хвост — не прочиталось"
    marked = "вырезано" in region
    daemon, _ = _host_answer_caps()
    if daemon is None:
        pair = "кап демона не прочитался — который из двух связывает, отсюда не видно"
    elif daemon > cap:
        pair = (f"демон отдаёт до {daemon} симв., я оставляю {cap} — связывает МОЙ рез, "
                f"он жёстче демонского в {daemon / cap:.1f}×")
    else:
        pair = f"демон отдаёт до {daemon} симв. — до моего капа {cap} вывод обычно не доживает"
    durable = (f"durable run: без ранней обрезки, полный ответ в ResultRef; "
               f"inline {policy['tool_inline_chars']} симв.; вне durable run: "
               if policy['durable_host_full'] else '')
    return (durable + f"{cap} симв. на вывод хоста ({shape}); {pair}; {places}; "
            + ("на месте выреза метка «вырезано N символов из M» с названным капом"
               if marked else
               "⚠ метки выреза в коде больше нет — значит рез стал молчаливым, и обрубок "
               "выглядит как весь ответ")
            + f" [{source}]")


def _forge_scan_value() -> str:
    """Что РЕАЛЬНО связывает обход, а не что написано в сигнатуре.

    ⚠ 27.07. Здесь называлось «не больше 20000 файлов» — дефолт параметра
    `source_files(limit=20000)`. Он не связывает НИЧЕГО: под бюджетом первая же строка
    тела делает `limit = min(int(limit), budget.files)`, а budget.files по умолчанию 12000.
    Второй связывающий предел — время (90с) — не назывался вовсе, хотя именно в него
    упирается обход большого дерева: 26.07 `impact('/tmp')` держал ядро 793с. Демон в
    своей ориентировке оба числа называет честно — врал только манифест.
    """
    try:
        import inspect as _inspect
        import forge_intelligence
        default = _inspect.signature(forge_intelligence.source_files).parameters["limit"].default
        impact_src = _inspect.getsource(forge_intelligence.impact)
        files_src = _inspect.getsource(forge_intelligence.source_files)
        budget_files = int(forge_intelligence.SCAN_FILES)
        budget_seconds = float(forge_intelligence.SCAN_SECONDS)
    except Exception as e:
        return f"⚠ forge_intelligence не читается: {e.__class__.__name__}"
    # Планку читаем из тела САМОЙ impact, а не из файла: в forge_intelligence несколько
    # вызовов source_files с разными limit, и файловая регулярка ловила чужой.
    impact_match = re.search(r"source_files\(root, limit=(\d+)", impact_src)
    impact_limit = int(impact_match.group(1)) if impact_match else None
    # Зажимает ли бюджет планку вызова — вопрос к коду, а не к моей памяти: снимут строку
    # `min(limit, budget.files)`, и связывать снова начнёт дефолт сигнатуры.
    clamped = re.search(r"limit = min\(int\(limit\), budget\.files\)", files_src) is not None
    # Признак усечения в ответе — не догадка и не память: смотрим, есть ли он в коде
    # самой impact прямо сейчас. Появится у соседа — рельс скажет правду без моей правки.
    marked = "truncated" in impact_src
    binding = (f"бюджет обхода {budget_files} файлов / {budget_seconds:.0f}с "
               f"(PRAXIS_FORGE_SCAN_FILES / PRAXIS_FORGE_SCAN_SECONDS)")
    if clamped:
        head = (f"связывает МЕНЬШЕЕ из двух: {binding} и планка самого вызова (у карты "
                f"влияния {_num(impact_limit)}); дефолт сигнатуры source_files(limit="
                f"{int(default)}) под бюджетом не связывает ничего")
    else:
        head = (f"планку зажимать некому (min(limit, budget.files) в source_files больше нет): "
                f"связывает дефолт сигнатуры {int(default)} и планка вызова "
                f"{_num(impact_limit)}; {binding} остаётся только сроком")
    return head + "; ответ " + ("НЕСЁТ признак усечения (impact.truncated/limits)" if marked
                                else "признака усечения НЕ несёт — часть дерева выглядит "
                                     "как всё дерево")


# ⚠ 27.07, третья правка. У замка форжа не один порог, а два, и второй в манифесте не
# значился: токен СТАРОГО образца (pid:uuid, без метки рождения) и нечитаемый файл замка
# отбираются жёстче, и PRAXIS_FORGE_LOCK_IDLE_SEC на них не действует вовсе. Верификация
# нашла там же вторую половину лжи: текст отказа называл 300с при реальных 120. Владелец
# forge.py правит это в той же волне, поэтому «назван ли легаси-порог в самом отказе» здесь
# не утверждается, а ПРОВЕРЯЕТСЯ по его коду — по имени константы или по числу.
_LOCK_LEGACY_NAME = "LOCK_LEGACY_IDLE_SEC"
_LOCK_REFUSAL_RE = re.compile(r"if time\.monotonic\(\) >= deadline:(.*?)"
                              r"raise TimeoutError\((.*?)\)\n", re.S)


def _legacy_lock_note() -> str:
    src = _source_text("forge.py")
    legacy = _neighbour_num("forge", _LOCK_LEGACY_NAME, "forge.py",
                            rf"(?m)^{_LOCK_LEGACY_NAME} = ([\d.]+)")
    if legacy is None:
        # Старая форма: литерал прямо в ветке, без имени.
        legacy = _from_source(
            "forge.py", r"stale = not _owner_alive\(owner_pid\) or idle_sec > ([\d.]+)", float)
    if legacy is None:
        return ""
    refusal = _LOCK_REFUSAL_RE.search(src)
    region = (refusal.group(1) + refusal.group(2)) if refusal else ""
    named = _LOCK_LEGACY_NAME in region or f"{legacy:.0f}" in region
    note = (f"; у замка СТАРОГО образца (токен pid:uuid без метки рождения) и у нечитаемого "
            f"файла замка порог свой и жёстче — {legacy:.0f}с, и PRAXIS_FORGE_LOCK_IDLE_SEC на "
            f"него не действует")
    if named:
        return note
    return note + (" (в тексте самого отказа он не называется: там я увижу порог бездействия, "
                   "а не тот, под который попал легаси-замок)")


def _forge_lock_value() -> str:
    try:
        import forge
    except Exception as e:
        return f"⚠ forge не читается: {e.__class__.__name__}"
    # Порог мог быть по ВОЗРАСТУ захвата (режет настоящую долгую работу) или по
    # ТИШИНЕ держателя (режет только зависшую). Разница для меня существенная —
    # называем ту форму, которая живёт в коде сейчас, а не ту, что помню.
    idle = getattr(forge, "LOCK_IDLE_ABANDONED_SEC", None)
    age = getattr(forge, "ABANDONED_AFTER_SEC", None)
    # Оба окна ожидания стояли здесь литералом «60с (у finish 120с)». Литерал переживает
    # правку соседа молча — читаем из его же сигнатуры и вызова.
    wait = _from_source("forge.py", r"def _mutation_lock\(task_id: str, timeout: float = ([\d.]+)",
                        float)
    wait_finish = _from_source("forge.py", r"_mutation_lock\(task_id, timeout=([\d.]+)\)", float)
    base = (f"ожидание замка {_num(wait and f'{wait:.0f}', 'с')} "
            f"(у finish {_num(wait_finish and f'{wait_finish:.0f}', 'с')}); ")
    legacy = _legacy_lock_note()
    # Лизинг — вторая половина правды о пороге: заранее объявленный долгий шаг ставит
    # метку в будущее, и порог тишины по нему не бьёт. Без этого числа порог читается как
    # «моя host-правка обязана уложиться в 300с», а это неправда.
    lease = ""
    try:
        host_lease = float(forge._remote_step_lease({"scope": "host"}))
        lease = (f"; заранее объявленный долгий шаг не считается тишиной (host-шаг "
                 f"объявляет {host_lease:.0f}с)")
    except Exception:
        lease = "; лизинг долгого шага не прочитался"
    if idle is not None and float(idle) > 0:
        return base + (f"брошенным считается замок, чей держатель молчит {float(idle):.0f}с "
                       f"(порог по БЕЗДЕЙСТВИЮ — долгая честная работа не режется)") + lease + legacy
    if idle is not None:
        return base + ("порог по бездействию ВЫКЛЮЧЕН (0): живого держателя не снимаю "
                       "совсем, только доказанно мёртвого — значит повисшая рука держит "
                       "задачу до рестарта") + lease + legacy
    if age is not None:
        return base + (f"брошенным считается замок старше {float(age):.0f}с от захвата "
                       f"(порог по ВОЗРАСТУ — длинная честная транзакция под него попадёт)")
    return base + ("порога заброшенности нет: замок снимается только смертью держателя, "
                   "а рука, повисшая внутри живого процесса, держит задачу до рестарта")


# --------- пороги соседей, заведённые волной 27.07 и не попавшие в манифест
#
# Их семнадцать, и завести им семнадцать рельсов значило бы утопить манифест в шуме: она
# читает его глазами, а не грепом. Поэтому они сведены по СМЫСЛУ — замки состояния, живость
# задачи, темп бэкфилла, бюджет счёта демона, срок отдельной проверки, — и в каждой записи
# перечислены поимённо, чтобы рычаг оставался находимым.
#
# Ни одного числа руками: у соседа сначала спрашивается живая константа (в ней env уже
# применён), и только если модуль в этом процессе не поднят — читается его объявление, о чём
# запись честно предупреждает. Скопированное число расходится с кодом молча — это ровно тот
# дефект, который мы сегодня чинили в четырёх местах этого же файла.

def _decl(name: str, call: str = "_env_float") -> str:
    """Регулярка на объявление вида `NAME = _env_float("PRAXIS_…", 60.0, …)`."""
    return rf"{re.escape(name)} = {call}\(\s*\"[^\"]*\",\s*([\d.]+)"


def _neighbour_num(module: str, name: str, rel: str, pattern: str) -> float | None:
    live = _live(module, name)
    if isinstance(live, (int, float)) and not isinstance(live, bool):
        return float(live)
    return _from_source(rel, pattern, float)


def _decl_note(module: str) -> str:
    """Приписка «числа не измерены, а прочитаны» — без неё это выдача дефолта за факт."""
    return ("" if sys.modules.get(module) else
            f" [{module} в этом процессе не поднят: числа из объявлений в коде, "
            f"переопределение из окружения здесь не видно]")


def _sec(value: float | None, unit: str = "с") -> str:
    if value is None:
        return "не прочиталось"
    return f"{value:g}{unit}"


def _forge_sec(name: str) -> float | None:
    """Срок форжа. `_env_sec` умеет scale (часы→секунды) — при чтении из кода его учитываем,
    иначе «6ч» превратилось бы в «6с» и порог выглядел бы катастрофически строгим."""
    live = _live("forge", name)
    if isinstance(live, (int, float)) and not isinstance(live, bool):
        return float(live)
    match = re.search(rf"{re.escape(name)} = _env_sec\(\s*\"[^\"]*\",\s*([\d.]+)"
                      rf"(?:,\s*scale=([\d.]+))?\)", _source_text("forge.py"))
    if not match:
        return None
    try:
        return float(match.group(1)) * (float(match.group(2)) if match.group(2) else 1.0)
    except Exception:
        return None


def _forge_task_liveness_value() -> str:
    lost = _forge_sec("TASK_ABANDONED_SEC")
    trust = _forge_sec("UNIT_LIVENESS_TRUST_SEC")
    if lost is None:
        first = "срок «потеряна из виду» не прочитался"
    elif lost <= 0:
        first = ("жнец ВЫКЛЮЧЕН (PRAXIS_FORGE_TASK_ABANDONED_H=0): брошенная задача не "
                 "разбудит меня никогда — она просто останется active навсегда")
    else:
        first = (f"active-задача без единого МЕСТНОГО следа {lost / 3600:g}ч → ярлык lost и одно "
                 f"пробуждение (PRAXIS_FORGE_TASK_ABANDONED_H); ничего не удаляется и не "
                 f"отменяется, первое моё действие возвращает её в active")
    if trust is None:
        second = "срок доверия номеру процесса не прочитался"
    elif trust <= 0:
        second = ("проверка легаси-юнита ВЫКЛЮЧЕНА (PRAXIS_FORGE_UNIT_TRUST_H=0): голому "
                  "номеру процесса верю без срока давности")
    else:
        second = (f"юниту без метки рождения (легаси) верю по голому номеру процесса "
                  f"{trust / 3600:g}ч, дальше его статус «unknown», а не «жив» "
                  f"(PRAXIS_FORGE_UNIT_TRUST_H)")
    # Приписка «числа не измерены» стоит СРАЗУ за числами форжа: два срока ниже приходят из
    # других модулей, и относить к ним чужую оговорку значило бы соврать про их источник.
    return first + "; " + second + _decl_note("forge") + "; " + _liveness_extra()


def _liveness_extra() -> str:
    """Ещё два срока того же смысла, не значившиеся нигде: просрочка воркера и тишина
    леджера прогонов. Оба решают ВИДИМУЮ мне судьбу работы — разбудят сигналом или сочтут
    неисполняемой, — и оба до 27.07 узнавались только в момент срабатывания."""
    overdue = _live("core.subagents", "overdue_minutes")
    minutes: float | None
    try:
        minutes = float(overdue()) if callable(overdue) else None
    except Exception:
        minutes = None
    if minutes is None:
        minutes = _from_source("core/subagents.py",
                               r'PRAXIS_FORGE_AGENT_OVERDUE_MIN", "(\d+)"', float)
    quiet = _neighbour_num("agent", "_RECONCILE_QUIET_SEC", "agent.py",
                           r"(?m)^_RECONCILE_QUIET_SEC = ([\d.]+)")
    if minutes is not None and minutes <= 0:
        worker = ("сигнала о просроченном воркере нет вовсе (PRAXIS_FORGE_AGENT_OVERDUE_MIN=0): "
