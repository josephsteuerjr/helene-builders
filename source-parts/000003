    и час не выдумывает себе задание.
    """
    try:
        import desires
        rows = desires.DesireLedger(BASE).list(statuses=("active",))
    except Exception:
        return ""
    lines = []
    for row in rows[:max(1, int(limit))]:
        statement = str(row.get("statement") or "").strip()
        if not statement:
            continue
        line = f"- {statement}"
        nxt = str(row.get("next_move") or "").strip()
        if nxt:
            line += f"\n  следующий шаг: {nxt}"
        lines.append(line)
    return "\n".join(lines)


