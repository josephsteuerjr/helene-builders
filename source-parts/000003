                    _voice_turn_with_typing(
                        entity, chat_id, last_n, speaker,
                        ctx=ctx, orient=topic_orient, media_refs=turn_media,
                        history=turn_history, current_text=turn_current,
                        occurrence_sidecar=turn_occurrences or None,
