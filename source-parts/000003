class GroupWake:
    """Immutable provenance for an addressed or reflective group pass."""

    message_id: int | None
    message_ts: float
    kind: str
    speaker: str
    sender_id: int | None
    owner: bool
    known: bool
    family: bool
    context_snapshot: str
    reply_targets_snapshot: tuple
    media_snapshot: tuple[media_core.MediaRef, ...]
    addressed: bool = True
    query: str = ""
    inbound_text: str = ""
    unread_during_turn: bool = False
    # Та же лента, но с авторством: ((её ли это строка, строка для роли), …).
