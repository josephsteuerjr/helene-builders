def ogg(size: int = 16) -> bytes:
    return b"OggS" + b"O" * max(0, size - 4)


def _set_idle(path: Path, seconds: float) -> None:
    """Сделать вид, что держатель молчит ``seconds`` секунд (пульса не было)."""

    stamp = time.time() - seconds
