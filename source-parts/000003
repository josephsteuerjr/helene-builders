                # виду планировщика навсегда, ничем себя не выдав. Теперь форму со
                # смещением часы читают (same_clock), а всё, что не читается и после
                # этого, видно ей через when_trouble в повестке.
                continue
            if deadline <= now:
                out.append(t)
    if changed:
        _save(items)
    return out


