                    str(row.get("pulse_id") or "") == pulse_id
                    and str(row.get("peer_id")) == str(peer_id)
                    and row.get("message_id") is not None
                    and message_id is not None
                    and int(row.get("message_id")) == int(message_id)
                )
            except (TypeError, ValueError):
