class StateCache(unittest.TestCase):
    def setUp(self):
        self.temp = tempfile.TemporaryDirectory()
        self.addCleanup(self.temp.cleanup)
        self.clock = Clock()
        self.box = TelegramOutbox(Path(self.temp.name) / "outbox", clock=self.clock)
