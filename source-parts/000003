def _main_loop() -> asyncio.AbstractEventLoop:
    """Луп, на котором реально живёт Telethon. Для sync-обёрток тулов (воркер-треды)."""
    if _LOOP is None:
        raise RuntimeError("луп Telethon ещё не захвачен (main() не стартовал)")
    return _LOOP


def _threadsafe_result(coro_factory, timeout: float):
    """Run on Telethon's captured loop without leaking or ghosting a coroutine.

    Resolve the loop before creating the coroutine. If the synchronous caller times out,
    propagate cancellation so a tool cannot report failure and then send something later.
    """
    loop = _main_loop()
    coro = coro_factory()
    settled = threading.Event()
    started = threading.Event()
    async def observed():
        started.set()
        try:
            return await coro
        finally:
            settled.set()
    wrapped = observed()
    try:
        future = asyncio.run_coroutine_threadsafe(wrapped, loop)
    except Exception:
        wrapped.close()
        coro.close()
        raise
    def cancelled_before_start(done):
        if not done.cancelled():
            return
        def close_unstarted():
            if not started.is_set():
                coro.close()
                settled.set()
        try:
            loop.call_soon_threadsafe(close_unstarted)
        except RuntimeError:
            close_unstarted()
    future.add_done_callback(cancelled_before_start)
    try:
        import step_control
        context = agent.run_context.current_run()
        if context is not None and not os.environ.get('PRAXIS_TEST'):
            step_control.track(step_control.FutureHandle(future, cancellable=True, settled=settled),
                               run_id=context.run_id, base=agent.MEM_DIR.parent)
        return future.result(timeout=timeout)
    except TimeoutError:
        future.cancel()
        raise


