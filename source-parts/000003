class _DirectSendTraceHarness(unittest.TestCase):
    """Стенд прямой отправки: свои архив, записка, буфер и леджер — живая память не тронута."""

    OWNER = 555000100
    GROUP = -1008881234567
    SAID = ("Поправка к моей реплике выше: я неточно сказала «у меня на Opus 5». "
