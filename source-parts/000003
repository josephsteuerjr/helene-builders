def floor() -> tuple[str, ...]:
    """Effective high-risk patterns; a classifier, not a capability boundary."""
    skip = {p.strip() for p in (os.getenv("PRAXIS_FLOOR_SKIP") or "").replace(";", ",").split(",")
            if p.strip()}
    return tuple(p for p in PROTECTED_PATTERNS if p not in skip)


